<%= render SdrViewComponents::Forms::RadioButtonGroupComponent.new(
      form:,
      field_name: :description_choice,
      label: t('edit.items.fields.description_choice.label'),
      mark_required: true,
      data: { controller: 'radio' }
    ) do |group| %>

  <% group.with_radio_button(
       label_text: title_choice_label,
       input_value: DescriptionChoiceFormConcern::DESCRIPTION_TITLE_CHOICE,
       input_data: { radio_target: 'radio', action: 'radio#toggle' },
       container_classes: 'my-fieldset'
     ) do %>
    <%= render SdrViewComponents::Forms::TextFieldComponent.new(form:, field_name: :title,
                                                                label_text: t('edit.items.fields.title.label'),
                                                                label_mark_required: true,
                                                                container_classes: 'my-field') %>

    <% if abstract_field? %>
      <%= render SdrViewComponents::Forms::TextAreaComponent.new(form:, field_name: :abstract,
                                                                 label_text: t('edit.collections.fields.abstract.label'),
                                                                 help_text: t('edit.collections.fields.abstract.help_text'),
                                                                 input_rows: 5,
                                                                 input_data: { radio_optional: true },
                                                                 container_classes: 'my-field') %>
    <% end %>
  <% end %>

  <% group.with_radio_button(
       label_text: t('edit.items.fields.description_choice.catalog_id.label'),
       input_value: DescriptionChoiceFormConcern::DESCRIPTION_CATALOG_ID_CHOICE,
       input_data: { radio_target: 'radio', action: 'radio#toggle' },
       container_classes: 'my-fieldset'
     ) do %>
    <%= render Edit::CatalogRecordIdComponent.new(form:) %>

    <% if item_fields? %>
      <%= render Edit::BarcodeComponent.new(form:) %>

      <%= render Edit::SerialsComponent.new(form:) %>
    <% end %>
  <% end %>

  <% if item_fields? %>
    <% group.with_radio_button(
         label_text: t('edit.items.fields.description_choice.spreadsheet.label'),
         input_value: NewItemForm::DESCRIPTION_SPREADSHEET_CHOICE,
         input_data: { radio_target: 'radio', action: 'radio#toggle' },
         container_classes: 'my-fieldset'
       ) do %>
      <%= render SdrViewComponents::Forms::FileComponent.new(form:,
                                                             field_name: :description_csv_file,
                                                             container_classes: 'my-field',
                                                             label_text: t('edit.items.fields.description_csv_file.label'),
                                                             label_hidden: true) %>
    <% end %>
  <% end %>

<% end %>
