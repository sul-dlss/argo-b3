<%= render SdrViewComponents::Forms::RadioButtonGroupComponent.new(
      form:,
      field_name: :source_id_choice,
      label: t('edit.items.fields.source_id.label'),
      mark_required: true,
      classes: 'mb-3',
      data: { controller: 'radio' }
    ) do |group| %>

  <% group.with_radio_button(
       label_text: t('edit.items.fields.source_id_choice.provided.label'),
       input_value: NewItemForm::SOURCE_ID_PROVIDED_CHOICE,
       input_data: { radio_target: 'radio', action: 'radio#toggle' },
       container_classes: 'd-flex align-items-center gap-2 ps-0 mb-2',
       input_classes: 'order-first ms-0'
     ) do %>
    <%= render SdrViewComponents::Forms::TextFieldComponent.new(
          form:,
          field_name: :source_id,
          label_text: t('edit.items.fields.source_id.label'),
          label_hidden: true,
          container_classes: 'flex-grow-1'
        ) %>
  <% end %>

  <% group.with_radio_button(
       label_text: t('edit.items.fields.source_id_choice.generate.label'),
       input_value: NewItemForm::SOURCE_ID_GENERATE_CHOICE,
       input_data: { radio_target: 'radio', action: 'radio#toggle' },
       container_classes: 'd-flex align-items-center gap-2 ps-0',
       input_classes: 'order-first ms-0'
     ) do %>
    <%= render SdrViewComponents::Forms::TextFieldComponent.new(
          form:,
          field_name: :source_id_prefix,
          label_text: t('edit.items.fields.source_id_prefix.label'),
          label_hidden: true,
          container_classes: 'flex-grow-1'
        ) %>
  <% end %>
<% end %>
