<%= render SdrViewComponents::Forms::RadioButtonGroupComponent.new(form:, field_name: :administrative,
                                                                   label: t('edit.content_file_sets.fields.content_files.administrative.label'),
                                                                   mark_required: true,
                                                                   classes: container_classes) do |group| %>
  <% ContentFileForm::ADMINISTRATIVE_OPTIONS.each do |administrative_option| %>
    <% group.with_radio_button(input_value: administrative_option,
                               label_text: label_text_for(administrative_option)) %>
  <% end %>
<% end %>
