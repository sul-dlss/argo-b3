<%= render SdrViewComponents::Forms::FieldsetComponent.new(label: t('edit.content_file_sets.fields.content_files.administrative.label'),
                                                           mark_required: true,
                                                           classes: container_classes) do %>
  <% ContentFileForm::ADMINISTRATIVE_OPTIONS.each do |administrative_option| %>
    <%= render SdrViewComponents::Forms::RadioButtonComponent.new(form:, field_name: :administrative,
                                                                  input_value: administrative_option,
                                                                  label_text: label_text_for(administrative_option)) %>
  <% end %>
  <%= render SdrViewComponents::Forms::InvalidFeedbackComponent.new(form:, field_name: :administrative_options) %>
<% end %>
