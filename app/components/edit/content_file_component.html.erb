<%= render SdrViewComponents::Elements::CardComponent.new(classes: 'mb-3', data: { content_files_target: 'row' }) do |card| %>
  <% card.with_body do %>
    <div class="card-title d-flex justify-content-between align-items-start">
      <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h5, text: filepath, variant: :h4) %>
      <%= render Elements::DeleteButtonComponent.new(label: t('edit.content_file_sets.buttons.remove_file', filepath:),
                                                     data: { action: 'content-files#remove' }) %>
    </div>
    <%= form.hidden_field :_destroy, data: { content_files_target: 'destroy' } %>
    <%= render SdrViewComponents::Forms::FieldsetComponent.new(label: t('edit.content_file_sets.fields.content_files.access.label'),
                                                               classes: 'my-fieldset') do %>
      <%= render Edit::AccessRightsComponent.new(form:, citation_only: false, container_classes: 'my-field') %>
    <% end %>
    <%= render Edit::FileAdministrativeComponent.new(form:, container_classes: 'my-fieldset') %>
    <%= render Edit::UseComponent.new(form:) %>
    <%= render Edit::MimeTypeComponent.new(form:) %>
    <%= render Edit::FileLanguageComponent.new(form:) %>
    <%= render SdrViewComponents::Forms::CheckboxComponent.new(
          form:,
          field_name: :corrected_for_accessibility,
          label_text: t('edit.content_file_sets.fields.content_files.corrected_for_accessibility.label'),
          container_classes: 'my-field'
        ) %>
  <% end %>
<% end %>
