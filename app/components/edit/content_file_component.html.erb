<%= tag.div class: 'card mb-3', data: { content_files_target: 'row' } do %>
  <div class="card-body">
    <div class="card-title d-flex justify-content-between align-items-start">
      <div class="h4"><%= filepath %></div>
      <%= render Elements::DeleteButtonComponent.new(label: t('edit.content_file_sets.buttons.remove_file', filepath:),
                                                     data: { action: 'content-files#remove' }) %>
    </div>
    <%= form.hidden_field :_destroy, data: { content_files_target: 'destroy' } %>
    <%= render SdrViewComponents::Forms::FieldsetComponent.new(label: t('edit.content_file_sets.fields.content_files.access.label'),
                                                               classes: 'my-fieldset') do %>
      <%= render Edit::AccessRightsComponent.new(form:, citation_only: false, container_classes: 'my-field') %>
    <% end %>
    <%= render SdrViewComponents::Forms::FieldsetComponent.new(label: t('edit.content_file_sets.fields.content_files.administrative.label'),
                                                               mark_required: true,
                                                               classes: 'my-fieldset') do %>
      <% ContentFileForm::ADMINISTRATIVE_OPTIONS.each do |administrative_option| %>
        <%= render SdrViewComponents::Forms::RadioButtonComponent.new(form:, field_name: :administrative,
                                                                      input_value: administrative_option,
                                                                      label_text: t("edit.content_file_sets.fields.content_files.administrative.options.#{administrative_option}")) %>
      <% end %>
      <%= render SdrViewComponents::Forms::InvalidFeedbackComponent.new(form:, field_name: :administrative_options) %>
    <% end %>
    <%= render SdrViewComponents::Forms::TextFieldComponent.new(form:, field_name: :use,
                                                                label_text: t('edit.content_file_sets.fields.content_files.use.label'),
                                                                label_classes: 'fw-bold',
                                                                container_classes: 'my-field') %>
    <%= render SdrViewComponents::Forms::TextFieldComponent.new(form:, field_name: :mime_type,
                                                                label_text: t('edit.content_file_sets.fields.content_files.mime_type.label'),
                                                                label_mark_required: true,
                                                                label_classes: 'fw-bold',
                                                                container_classes: 'my-field') %>
  </div>
<% end %>
