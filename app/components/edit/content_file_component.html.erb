<div class="card mb-3">
  <div class="card-body">
    <div class="card-title">
      <div class="h4"><%= filepath %></div>
    </div>
    <%= render SdrViewComponents::Forms::TextFieldComponent.new(form:, field_name: :use,
                                                                label_text: t('edit.content_file_sets.fields.content_files.use.label'),
                                                                label_classes: 'fw-bold',
                                                                container_classes: 'my-field') %>
    <%= render SdrViewComponents::Forms::TextFieldComponent.new(form:, field_name: :mime_type,
                                                                label_text: t('edit.content_file_sets.fields.content_files.mime_type.label'),
                                                                label_mark_required: true,
                                                                label_classes: 'fw-bold',
                                                                container_classes: 'my-field') %>
  </div>
</div>
