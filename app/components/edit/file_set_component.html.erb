<%= render SdrViewComponents::Elements::CardComponent.new(classes:) do |card| %>
  <% card.with_body do %>
    <div class="card-title">
      <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h4, text: "Resource (#{index}):", variant: :h3) %>
    </div>
    <div class="card-body">
      <%= form_with model: content_file_set_form, url: path do |form| %>
      <%= render SdrViewComponents::Forms::SelectFieldComponent.new(form:, field_name: :file_set_type,
                                                                    options: file_set_type_options,
                                                                    label_text: t('edit.content_file_sets.fields.file_set_type.label'),
                                                                    label_mark_required: true,
                                                                    label_classes: 'fw-bold',
                                                                    container_classes: 'my-field') %>

      <%= render SdrViewComponents::Forms::TextFieldComponent.new(form:, field_name: :label,
                                                                  label_text: t('edit.content_file_sets.fields.label.label'),
                                                                  label_classes: 'fw-bold',
                                                                  container_classes: 'my-field') %>

      <div data-controller="content-files">
        <%= form.fields_for :content_files do |content_file_form| %>
          <%= render Edit::ContentFileComponent.new(form: content_file_form) %>
        <% end %>
        <%# The alert region stays in the page so that showing the note is announced. %>
        <div role="alert">
          <p class="text-danger" hidden data-content-files-target="allRemovedNote"><%= t('edit.content_file_sets.all_files_removed') %></p>
        </div>
      </div>

        <%= render Elements::FormFooterComponent.new(cancel_path: path) do %>
          <%= render SdrViewComponents::Forms::SubmitComponent.new(label: 'Save', data: { disable_actions_target: 'disableable' }) %>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
