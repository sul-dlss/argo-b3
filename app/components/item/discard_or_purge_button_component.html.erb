<%# A link rather than a form, since the button is inside the edit form. %>
<%= render SdrViewComponents::Elements::ButtonLinkComponent.new(
      link: draft_actions_presenter.path,
      variant: :'outline-primary',
      classes: 'ms-2',
      data: { turbo_method: :delete, turbo_confirm: draft_actions_presenter.confirm, **data }
    ) do %>
  <%= helpers.delete_icon(classes: 'me-1', aria: { hidden: true }) %><%= draft_actions_presenter.label %>
<% end %>
