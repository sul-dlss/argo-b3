<div class="d-flex">
  <% if navigation? %>
    <%= navigation %>
  <% else %>
    <%= render Item::TabNavigationComponent.new(pane:, cancel_path:, show_next:, show_previous:, cancel_data:) %>
  <% end %>
  <%# Fieldsets, so that disabling them (e.g., while uploading) doesn't conflict with disabling the submit buttons. %>
  <% if deposit? %>
    <%= tag.fieldset class: 'd-flex', data: actions_data do %>
      <%= render SdrViewComponents::Forms::SubmitComponent.new(
            label: t('edit.items.edit.buttons.deposit'),
            form_id:,
            value: ItemsController::DEPOSIT_VALUE,
            classes: 'ms-2',
            data: submit_data
          ) %>
    <% end %>
  <% end %>
  <%= tag.fieldset class: 'd-flex ms-auto', data: actions_data do %>
    <% if show_edit_files %>
      <%= render SdrViewComponents::Forms::SubmitComponent.new(
            label: t('edit.items.edit.buttons.draft_edit_files'),
            form_id:,
            value: ItemsController::DRAFT_TO_ADD_FILES_VALUE,
            variant: 'outline-primary',
            classes: 'me-2',
            data: submit_data
          ) %>
    <% end %>
    <%= render SdrViewComponents::Forms::SubmitComponent.new(
          label: t('edit.items.edit.buttons.draft'),
          form_id:,
          value: ItemsController::DRAFT_VALUE,
          variant: 'outline-primary',
          data: submit_data
        ) %>
    <%= render Item::DiscardOrPurgeButtonComponent.new(draft_actions_presenter:, data: actions_data) %>
  <% end %>
</div>
