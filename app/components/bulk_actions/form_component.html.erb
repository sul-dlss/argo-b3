<%= render Layout::ContainerComponent.new(heading: label, classes: 'b3-form') do %>
  <%= content %>

  <%= render SdrViewComponents::Forms::TextAreaComponent.new(form:,
                                                             field_name: :description,
                                                             container_classes: 'my-fieldset',
                                                             label_text: 'Describe this bulk action',
                                                             label_classes: 'fw-bold',
                                                             input_rows: 3) %>

  <% if close_version? %>
    <%= render SdrViewComponents::Forms::CheckboxComponent.new(form:,
                                                               field_name: :close_version,
                                                               container_classes: 'my-fieldset',
                                                               label_classes: 'fw-bold',
                                                               label_text: 'Deposit objects once action is complete',
                                                               help_text: 'Uncheck this option if you want to make additional edits to these objects before depositing the version.') %>
  <% end %>

  <%= render Elements::FormFooterComponent.new(cancel_path: new_bulk_action_path) do %>
    <%= render SdrViewComponents::Forms::SubmitComponent.new(label: 'Submit') %>
  <% end %>
<% end %>
