<%= tag.div class: 'container bulk-action-show object-type-bulk-action mb-4', data: do %>
  <%= render Structure::TwoColumnWithHeaderComponent.new do |layout| %>
    <% layout.with_top_content do %>
      <%= render SdrViewComponents::Elements::ButtonLinkComponent.new(label: '← Bulk action', classes: 'ps-0',
                                                                      variant: :link, link: bulk_actions_path) %>

      <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
        <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h1, text: label, classes: 'mb-0') %>
        <span class="object-type-bg fw-bold text-uppercase rounded-pill fs-4 px-3 py-1">Bulk action</span>
      </div>
    <% end %>

    <% layout.with_left_content do %>
      <%= render Elements::ButtonListComponent.new do |component| %>
        <% component.with_button(link: new_bulk_action_path, label: 'Bulk actions menu', variant: 'outline-primary') %>
        <% component.with_button(link: bulk_actions_path, label: 'Bulk actions history', variant: 'outline-primary') %>
      <% end %>
    <% end %>

    <% layout.with_main_content do %>
      <div class="d-flex flex-column flex-xl-row gap-4 mt-4 mb-4">
        <div class="show-box flex-fill">
          <%= render Show::BoxComponent.new(heading: status_heading) do %>
            <p class="mb-1"><%= helpers.format_datetime(bulk_action.updated_at) %></p>
            <% if bulk_action.description.present? %>
              <p class="mb-0"><%= bulk_action.description %></p>
            <% end %>
          <% end %>
        </div>

        <div class="show-box flex-fill">
          <%= render Show::BoxComponent.new(heading: 'Total / Success / Failed') do %>
            <p class="mb-0 text-center fs-4">
              <%= bulk_action.druid_count_total %> / <%= bulk_action.druid_count_success %> / <%= bulk_action.druid_count_fail %>
            </p>
          <% end %>
        </div>

        <% if downloads.present? %>
          <div class="show-box flex-fill">
            <%= render Show::BoxComponent.new(heading: safe_join([helpers.download_icon(aria: { hidden: true }, classes: 'me-2'), 'Downloads'], ' ')) do %>
              <ul class="mb-0">
                <% downloads.each do |download_link| %>
                  <li><%= download_link %></li>
                <% end %>
              </ul>
            <% end %>
          </div>
        <% end %>
      </div>

      <% if tabs? %>
        <%= render SdrViewComponents::Elements::Tabs::TabListComponent.new(variant: :underline) do |tab_list| %>
          <% shown_exports.each do |export| %>
            <% tab_list.with_tab(id: export_tab_id(export), pane_id: export_pane_id(export), label: export.label,
                                 active: export_tab_id(export) == active_tab_id) %>
          <% end %>
          <% if error_lines.present? %>
            <% tab_list.with_tab(id: errors_tab_id, pane_id: errors_pane_id, label: 'Errors',
                                 active: errors_tab_id == active_tab_id) %>
          <% end %>

          <% shown_exports.each do |export| %>
            <% export_csv = export_csv(export) %>
            <%= tab_list.with_pane(id: export_pane_id(export), tab_id: export_tab_id(export),
                                   active: export_tab_id(export) == active_tab_id) do %>
              <%= render SdrViewComponents::Tables::TableComponent.new(id: export_table_id(export), label: export.label, show_label: false, variant: :data, responsive: true, empty_message: 'No records.') do |table| %>
                <% export_csv.headers.each do |header| %>
                  <% table.with_header(label: header) %>
                <% end %>
                <% export_csv.each do |row| %>
                  <% table.with_row(values: export_row_values(row)) %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>

          <% if error_lines.present? %>
            <%= tab_list.with_pane(id: errors_pane_id, tab_id: errors_tab_id, active: errors_tab_id == active_tab_id) do %>
              <pre class="mb-0"><%= error_lines.join("\n") %></pre>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
