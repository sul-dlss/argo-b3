<%= tag.section class: classes, id: do %>
  <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h2, text: label) %>
  <ul class="list-unstyled vstack gap-4">
    <% bulk_action_configs.each do |bulk_action_config| %>
      <li>
        <%= link_to(bulk_action_config.label, bulk_action_config.new_path, class: 'fw-bold su-underline') %>
        <% if bulk_action_config.help_text.present? %>
          <p class="mb-0"><%= bulk_action_config.help_text %></p>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
