<%= tag.div class: 'container mt-3', data: do %>
  <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h1, text: heading, classes: 'mb-4') %>

  <%# Morph refreshes skip the form, since morphing breaks Tom Select. %>
  <%= form_with model: filter_form, url: bulk_actions_path, method: :get,
                id: 'bulk-actions-filter', class: 'd-flex gap-3 mb-4 align-items-end',
                data: { controller: 'skip-morph', action: 'turbo:before-morph-element->skip-morph#skip' } do |form| %>
    <% if admin? %>
      <%= render Elements::Forms::MultiSelectFilterComponent.new(form:, field_name: :user_ids, options: filter_form.user_options,
                                                                 label_text: 'Users') %>
    <% end %>
    <%= render Elements::Forms::MultiSelectFilterComponent.new(form:, field_name: :action_types, options: filter_form.action_type_options,
                                                               label_text: 'Actions') %>
    <%= render Elements::Forms::MultiSelectFilterComponent.new(form:, field_name: :statuses, options: filter_form.status_options,
                                                               label_text: 'Statuses', select_all: false) %>
    <%= render SdrViewComponents::Forms::SelectFieldComponent.new(form:, field_name: :submitted_date, options: filter_form.submitted_date_options,
                                                                  label_text: 'Submitted date') %>
    <div>
      <%= render SdrViewComponents::Forms::SubmitComponent.new(label: 'Filter', variant: 'outline-primary') %>
    </div>
  <% end %>

  <%= render Elements::Pagination::BriefComponent.new(total_pages:, current_page:, path_func:, total_results: total_count, per_page: limit_value) %>

  <%= render SdrViewComponents::Tables::RawTableComponent.new(label: heading, show_label: false, id: 'bulk-actions-history-table', empty_message: 'No bulk actions.') do |table| %>
    <%= table.with_header(label: 'Bulk action', style: "width: #{admin? ? 20 : 30}%;") %>
    <% if admin? %>
      <%= table.with_header(label: 'User', style: 'width: 10%;') %>
    <% end %>
    <%= table.with_header(label: 'Action', style: 'width: 10%;') %>
    <%= table.with_header(label: 'Submitted', style: 'width: 10%;') %>
    <%= table.with_header(label: 'Status', style: 'width: 10%;') %>
    <%= table.with_header(label: 'Total / Success/ Failed', style: 'width: 15%;') %>
    <%= table.with_header(label: 'Downloads', style: 'width: 15%;') %>
    <%= table.with_header(label: '', style: 'width: 10%;') %>
    <% bulk_actions.each do |bulk_action| %>
      <% table.with_row do %>
        <%= render BulkActions::HistoryRowComponent.new(bulk_action:, admin: admin?) %>
      <% end %>
    <% end %>
  <% end %>

  <%= render Elements::Pagination::FullComponent.new(total_pages:, current_page:, path_func:) %>
<% end %>
