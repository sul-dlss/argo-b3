<%= render Dashboard::SectionComponent.new(id: 'pinned-apos-section', label:, pinned: true, classes:) do %>
  <%= render SdrViewComponents::Tables::TableComponent.new(
        empty_message: t('dashboard.pinned_apos.empty'),
        label:,
        show_label: false,
        responsive: true
      ) do |component| %>
    <% component.with_header(label: t('dashboard.headers.title')) %>
    <% component.with_header(label: t('dashboard.headers.druid')) %>
    <% component.with_header(label: t('dashboard.headers.agreement')) %>
    <% component.with_header(label: t('dashboard.headers.unpin'), classes: 'pin-column') %>
    <% pinned_apo_docs.each do |apo_doc| %>
      <% component.with_row do |row_component| %>
        <% row_component.with_cell do %>
          <%= title_link(apo_doc) %>
        <% end %>
        <% row_component.with_cell do %>
          <%= apo_doc.bare_druid %>
        <% end %>
        <% row_component.with_cell do %>
          <%= agreement_link(apo_doc) %>
        <% end %>
        <% row_component.with_cell(classes: 'pin-column') do %>
          <%= render Pin::PinnedObjectComponent.new(druid: apo_doc.druid, pinned: true) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
