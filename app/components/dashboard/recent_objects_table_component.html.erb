<%= render Dashboard::SectionComponent.new(id: 'recent-objects-section', label:) do %>
  <%= render SdrViewComponents::Tables::TableComponent.new(
        empty_message: t('dashboard.recent_objects.empty'),
        label:,
        show_label: false,
        responsive: true
      ) do |component| %>
    <% component.with_header(label: t('dashboard.headers.title')) %>
    <% component.with_header(label: t('dashboard.headers.druid')) %>
    <% component.with_header(label: t('dashboard.headers.object_type')) %>
    <% component.with_header(label: t('dashboard.headers.tags')) %>
    <% recent_object_docs.each do |object_doc| %>
      <% component.with_row do |row_component| %>
        <% row_component.with_cell do %>
          <%= title_link(object_doc) %>
        <% end %>
        <% row_component.with_cell do %>
          <%= object_doc.bare_druid %>
        <% end %>
        <% row_component.with_cell do %>
          <%= object_doc.object_type_label %>
        <% end %>
        <% row_component.with_cell do %>
          <%= render SdrViewComponents::Tables::ListCellComponent.new(item_values: Array(object_doc.all_tags)) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
