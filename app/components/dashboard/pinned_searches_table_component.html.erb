<%= render SdrViewComponents::Tables::TableComponent.new(
      empty_message: 'No searches have been pinned.',
      classes:,
      label:,
      responsive: true
    ) do |component| %>
  <% component.with_caption do %>
    <%= label %>
    <%= helpers.pin_icon(classes: 'pinned') %>
  <% end %>
  <% component.with_header(label: 'Search') %>
  <% component.with_header(label: 'Unpin') %>
  <% pinned_searches.each do |search| %>
    <% component.with_row do |row_component| %>
      <% row_component.with_cell do %>
        <%= search_link(search) %>
      <% end %>
      <% row_component.with_cell do %>
        <%= render Pin::PinnedSearchComponent.new(search_form: search.to_search_form, pinned: true) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
