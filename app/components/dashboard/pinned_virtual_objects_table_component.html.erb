<%= render Dashboard::SectionComponent.new(id: 'pinned-virtual-objects-section', label:, pinned: true, classes:) do %>
  <%= render SdrViewComponents::Tables::TableComponent.new(
        empty_message: t('dashboard.pinned_virtual_objects.empty'),
        label:,
        show_label: false,
        responsive: true
      ) do |component| %>
    <% component.with_header(label: t('dashboard.headers.title')) %>
    <% component.with_header(label: t('dashboard.headers.druid')) %>
    <% component.with_header(label: t('dashboard.headers.collection')) %>
    <% component.with_header(label: t('dashboard.headers.apo')) %>
    <% component.with_header(label: t('dashboard.headers.constituents_count')) %>
    <% component.with_header(label: t('dashboard.headers.unpin'), classes: 'pin-column') %>
    <% pinned_virtual_object_docs.each do |virtual_object_doc| %>
      <% component.with_row do |row_component| %>
        <% row_component.with_cell do %>
          <%= title_link(virtual_object_doc) %>
        <% end %>
        <% row_component.with_cell do %>
          <%= virtual_object_doc.bare_druid %>
        <% end %>
        <% row_component.with_cell do %>
          <%= render SdrViewComponents::Tables::ListCellComponent.new(item_values: collection_link_values(virtual_object_doc)) %>
        <% end %>
        <% row_component.with_cell do %>
          <%= apo_link(virtual_object_doc) %>
        <% end %>
        <% row_component.with_cell do %>
          <%= virtual_object_doc.constituents_count %>
        <% end %>
        <% row_component.with_cell(classes: 'pin-column') do %>
          <%= render Pin::PinnedObjectComponent.new(druid: virtual_object_doc.druid, pinned: true) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
