<%= render Dashboard::SectionComponent.new(id: 'recent-drafts-and-deposits-section', label:) do %>
  <%= render SdrViewComponents::Tables::TableComponent.new(
        label:,
        show_label: false,
        id: 'recent-drafts-and-deposits-table',
        responsive: true
      ) do |component| %>
    <% component.with_header(label: t('dashboard.headers.title')) %>
    <% component.with_header(label: t('dashboard.headers.druid')) %>
    <% component.with_header(label: t('dashboard.headers.collection')) %>
    <% component.with_header(label: t('dashboard.headers.status')) %>
    <% component.with_header(label: t('dashboard.headers.last_updated')) %>
    <% object_docs.each do |object_doc| %>
      <% component.with_row do |row_component| %>
        <% row_component.with_cell do %>
          <%= title_link(object_doc) %>
        <% end %>
        <% row_component.with_cell do %>
          <%= object_doc.bare_druid %>
        <% end %>
        <% row_component.with_cell do %>
          <%= render SdrViewComponents::Tables::ListCellComponent.new(item_values: collection_link_values(object_doc)) %>
        <% end %>
        <% row_component.with_cell do %>
          <%= status_label(object_doc) %>
        <% end %>
        <% row_component.with_cell do %>
          <%= last_updated_date(object_doc) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
  <%= link_to t('dashboard.recent_drafts_and_deposits.view_all'), search_path %>
<% end %>
