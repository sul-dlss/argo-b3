<%= tag.section 'aria-label': "Loading #{label}", class: 'mb-5' do %>
  <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h2, variant: :h3, text: "#{label} (Loading ...)") %>

  <ul class="list-unstyled placeholder-glow">
    <% (1..number_of_placeholders).each do |index| %>
      <li>
        <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h3, variant: :h4) do %>
          <span class="fw-light me-1"><%= index %>.</span>
          <span class="placeholder col-6"></span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
