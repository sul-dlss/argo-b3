<%= form_builder.hidden_field :query if query_hidden_field? %>

<% search_form.facet_attributes.each do |attr_name, values| %>
  <% next if form_fields.include?(attr_name) %>
  <% if values.is_a?(Array) %>
    <% values.each do |value| %>
      <%= form_builder.hidden_field(attr_name.to_sym, value:, multiple: true) %>
    <% end %>
  <% else %>
    <%= form_builder.hidden_field(attr_name.to_sym, value: values) %>
  <% end %>
<% end %>
