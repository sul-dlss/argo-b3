<% if selected? %>
  <span class="facet-label">
    <span class="selected"><%= label %></span>

    <%= render_remove_link %>
  </span>
<% elsif exclude_selected? %>
  <span class="facet-label">
    <del><%= label %></del>
  </span>
  <span class="facet-count"><%= number_with_delimiter(count) %></span>
  <span class="ms-2">
    <strong>excluded</strong>
    <%= render_remove_link %>
  </span>
<% else %>
  <span class="facet-label">
    <%= link_to label, url_for(search_form.with({ form_field => [value], page: nil })), **link_args %>
  </span>
  <span class="facet-count"><%= number_with_delimiter(count) %></span>
  <% if with_exclude? %>
    <%= render SdrViewComponents::Elements::ButtonLinkComponent.new(link: exclude_path, variant: :link, size: :sm, classes: 'ms-2 p-0 align-baseline', **link_args) do %>
      <span aria-hidden="true">exclude</span>
      <span class="visually-hidden"><%= exclude_label %></span>
    <% end %>
  <% end %>
<% end %>
