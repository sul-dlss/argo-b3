<% if selected? %>
  <span class="facet-label">
    <span class="selected"><%= label %></span>

    <%= render_remove_link %>
  </span>
<% elsif exclude_selected? %>
  <span class="facet-label">
    <del><%= label %></del>
  </span>
  <span class="facet-count"><%= number_with_delimiter(count) %></span>
  <%= render_excluded %>
<% else %>
  <span class="facet-label">
    <%= link_to label, select_path, **link_args %>
  </span>
  <span class="facet-count"><%= number_with_delimiter(count) %></span>
  <%= render_exclude_link if with_exclude? %>
<% end %>
