<% if selected? || exclude_selected? %>
  <span class="facet-label">
    <span class="selected"><%= label %></span>

    <%= link_to remove_path, class: 'remove ms-2', rel: 'nofollow', title: remove_title, **link_args do %>
      <%= helpers.remove_icon(classes: 'ms-2') %>

      <span class="visually-hidden">[<%= remove_title %>]</span>
    <% end %>
  </span>
<% else %>
  <span class="facet-label">
    <%= link_to label, url_for(search_form.with({ form_field => [value], page: nil })), **link_args %>
  </span>
  <span class="facet-count"><%= number_with_delimiter(count) %></span>
  <% if with_exclude? %>
    <%= link_to url_for(search_form.with({ exclude_form_field => [value], page: nil })), title: exclude_title, **link_args do %>
      <%= helpers.exclude_icon(classes: 'ms-2') %>
    <% end %>
  <% end %>
<% end %>
