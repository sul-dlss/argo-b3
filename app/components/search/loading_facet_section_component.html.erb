<%= tag.section 'aria-label': "Loading #{label}", class: 'accordion mb-1' do %>
  <div class="accordion-item facet-limit">
    <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h3, variant: :h6, classes: 'accordion-header p-0 facet-field-heading') do %>
      <%= tag.button class: 'accordion-button collapsed', type: 'button', disabled: true do %>
        <%= label %>
        <%= render SdrViewComponents::Elements::SpinnerComponent.new(message: "Loading #{label} ...", hide_message: true, classes: 'ms-auto', height: 20, width: 20, spinner_classes: 'ms-1') %>
      <% end %>
    <% end %>
  </div>
<% end %>
