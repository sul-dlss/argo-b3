<%= helpers.form_with model: search_form, scope: '', url: url_for(search_form.cleared), method: :get, class: 'facet-values mt-4' do |form| %>
  <%= render Search::FormHiddenFieldsComponent.new(form_builder: form, search_form:,
                                                   form_fields: %i[dates_from dates_to]) %>

  <div class="row g-3">
    <%= render SdrViewComponents::Forms::TextFieldComponent.new(form:, field_name: :dates_from, label_text: 'From',
                                                                label_classes: 'fw-bold', input_type: 'number', input_step: 1,
                                                                container_classes: 'col') %>
    <%= render SdrViewComponents::Forms::TextFieldComponent.new(form:, field_name: :dates_to, label_text: 'To',
                                                                label_classes: 'fw-bold', input_type: 'number', input_step: 1,
                                                                container_classes: 'col') %>
  </div>

  <%= render SdrViewComponents::Forms::SubmitComponent.new(label: 'Filter', variant: :primary, classes: 'btn-sm mt-3') %>
<% end %>
