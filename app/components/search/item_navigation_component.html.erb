<div class="d-flex align-items-center flex-wrap">
  <%= render SdrViewComponents::Elements::ButtonLinkComponent.new(label: '← Search results', classes: 'ps-0',
                                                                  variant: :link,
                                                                  link: search_path(last_search_form.attributes)) %>

  <% if item_navigation? %>
    <nav class="item-search-navigation d-flex align-items-center ms-3" aria-label="Search results navigation" data-turbo-prefetch="false">
      <% if previous_druid.present? %>
        <%= render SdrViewComponents::Elements::ButtonLinkComponent.new(label: '« Previous', link: previous_path,
                                                                        variant: :link, classes: 'px-0',
                                                                        data: { turbo_frame: '_top' }, rel: 'prev',
                                                                        'aria-label': 'Go to previous item in search results') %>
      <% else %>
        <span class="btn btn-link disabled px-0" aria-disabled="true">« Previous</span>
      <% end %>

      <span class="mx-2 fw-bold"><%= current_position %></span> of <span class="mx-2 fw-bold"><%= number_with_delimiter(total_results) %></span>

      <% if next_druid.present? %>
        <%= render SdrViewComponents::Elements::ButtonLinkComponent.new(label: 'Next »', link: next_path,
                                                                        variant: :link, classes: 'px-0',
                                                                        data: { turbo_frame: '_top' }, rel: 'next',
                                                                        'aria-label': 'Go to next item in search results') %>
      <% else %>
        <span class="btn btn-link disabled px-0" aria-disabled="true">Next »</span>
      <% end %>
    </nav>
  <% end %>
</div>
