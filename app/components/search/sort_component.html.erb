<div class="sort-dropdown ms-auto">
  <%= render SdrViewComponents::Elements::ButtonComponent.new(label: dropdown_label,
                                                              variant: :'outline-primary',
                                                              classes: 'ms-3 dropdown-toggle',
                                                              data: { 'bs-toggle': 'dropdown' },
                                                              aria: { expanded: false }) %>

  <div class="dropdown-menu" role="menu">
    <% sort_options.each do |sort| %>
      <%= render SdrViewComponents::Elements::Navigation::DropdownLinkComponent.new(
            label: label_for(sort),
            link: search_items_path(search_form.with_attributes(sort:, page: nil)),
            role: 'menuitem'
          ) %>
    <% end %>
  </div>
</div>
