<section
  aria-label="Current Filters"
  class="container d-flex align-items-center mb-3">
  <%= render Elements::DivHeadingComponent.new(level: 2, label: 'Your selections:', class: 'fw-bold me-2') %>

  <ul class="list-unstyled d-flex mb-0">
    <% current_filters.each do |form_field, values| %>
      <%= render Search::CurrentFilterComponent.new(form_field:, values:, search_form: @search_form, facet_labels:) %>
    <% end %>
  </ul>

  <% if pinnable? %>
    <span class="object-type-search">
      <%= render Pin::PinnedSearchComponent.new(search_form:, pinned:) %>
    </span>
  <% end %>

  <%= render SdrViewComponents::Elements::ButtonLinkComponent.new(label: 'Clear all', link: clear_all_path, variant: :'outline-primary', classes: 'ms-3') %>
</section>
