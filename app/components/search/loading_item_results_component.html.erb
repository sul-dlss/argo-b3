<section aria-label="Loading item, collection, and APO results">
  <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h2, variant: :h3, text: 'Item, collection, and APO results (Loading ...)') %>

  <ul class="list-unstyled placeholder-glow">
    <% (1..number_of_placeholders).each do |index| %>
      <%= tag.li class: 'mb-5' do %>
        <%# Laid out as Search::ItemResultComponent is, so the page doesn't shift when results load. %>
        <%= render Search::ResultHeadingComponent.new(index:, classes: 'search-result-heading') do |heading| %>
          <%= heading.with_link do %>
            <span class="placeholder col-8"></span>
          <% end %>
        <% end %>
        <%= render SdrViewComponents::Tables::RawTableComponent.new(id: "placeholder-#{index}", label: 'Loading result', show_label: false) do |component| %>

          <% number_of_placeholder_rows.times do %>
            <%= component.with_row do %>
              <tr>
                <th class="col-3" scope="row">
                  <span class="placeholder col-8"></span>
                </th>

                <td class="col-9"><span class="placeholder col-8"></span></td>
              </tr>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </ul>
</section>
