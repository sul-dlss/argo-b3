<div class="search-bar">
  <nav aria-label="Search form" class="container py-2 mb-3">
    <!-- From component library: https://sul-dlss.github.io/component-library/forms/ -->
    <search class="search-card d-flex position-relative flex-wrap align-items-center column-gap-3 row-gap-2 py-2 rounded">
      <%= helpers.form_with model: search_form, scope: '', url:, method: :get, class: 'search-query-form' do |form| %>
        <%= render Search::FormHiddenFieldsComponent.new(form_builder: form, search_form:, form_fields: :query) %>
        <div class="input-group">
          <%= render SdrViewComponents::Forms::LabelComponent.new(form:,
                                                                  field_name: :query,
                                                                  text: 'Search for',
                                                                  hidden: true) %>
          <%= render SdrViewComponents::Forms::BasicTextFieldComponent.new(form:,
                                                                           field_name: :query,
                                                                           placeholder: 'Search by keyword',
                                                                           classes: 'search-q q',
                                                                           type: 'search') %>
          <%= render SdrViewComponents::Elements::ButtonComponent.new(variant: :primary, classes: 'search-btn',
                                                                      type: 'submit', id: 'search') do %>
            <span class="submit-search-text">Search</span>
          <% end %>
        </div>
      <% end %>
      <%= link_to t('search.advanced'), advanced_search_path, class: 'text-black text-decoration-underline' %>
    </search>
  </nav>
</div>
