<%= render SdrViewComponents::Structure::HeaderComponent.new(title: t('layouts.application.product_name'), variant: :dark, background_color: 'var(--stanford-archway-dark-rgb)') do |header| %>
  <%= header.with_primary_navigation_link do %>
    <%= render SdrViewComponents::Elements::Navigation::NavItemComponent.new(text: t('notifications.heading'), path: notifications_path) %>
    <%= render SdrViewComponents::Elements::Navigation::NavItemComponent.new(text: 'Feedback', path: "mailto:#{Settings.support_email}") %>
    <%= render SdrViewComponents::Elements::Navigation::NavItemComponent.new(text: logged_in_text) %>
  <% end %>
  <%= header.with_secondary_navigation_link do %>
    <%= render SdrViewComponents::Elements::Navigation::NavItemComponent.new(text: 'Workflow status', path: workflow_grid_path) %>
    <%= render Elements::Navigation::MegaMenuComponent.new(text: 'Bulk actions') do |menu| %>
      <% menu.with_section(label: t('bulk_actions.sections.pages'), featured: true) do |section| %>
        <% section.with_link(label: t('bulk_actions.tabs.history'), link: bulk_actions_path) %>
        <% section.with_link(label: t('bulk_actions.menu'), link: new_bulk_action_path) %>
      <% end %>
      <% bulk_action_sections.each do |bulk_action_section, bulk_action_configs| %>
        <% menu.with_section(label: BulkActions.section_label(bulk_action_section)) do |section| %>
          <% bulk_action_configs.each do |bulk_action_config| %>
            <% section.with_link(label: bulk_action_config.label, link: bulk_action_config.new_path) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= render SdrViewComponents::Elements::Navigation::DropdownMenuComponent.new(text: 'Register and deposit') do |dropdown| %>
      <% dropdown.with_item do %>
        <%= render SdrViewComponents::Elements::Navigation::DropdownHeaderComponent.new(text: 'Single object', classes: 'h4 text-body text-uppercase') %>
      <% end %>
      <% dropdown.with_item do %>
        <%= render SdrViewComponents::Elements::Navigation::DropdownLinkComponent.new(label: 'Item', link: new_item_path, disabled: !can_register_item?) %>
      <% end %>
      <% dropdown.with_item do %>
        <%= render SdrViewComponents::Elements::Navigation::DropdownLinkComponent.new(label: 'Collection', link: new_collection_path, disabled: !can_register_collection?) %>
      <% end %>
      <% dropdown.with_item do %>
        <%= render SdrViewComponents::Elements::Navigation::DropdownLinkComponent.new(label: 'APO', link: new_apo_path, disabled: !can_register_apo?) %>
      <% end %>
      <% dropdown.with_item do %>
        <%= render SdrViewComponents::Elements::Navigation::DropdownLinkComponent.new(label: 'Agreement', link: new_agreement_path, disabled: !can_register_agreement?) %>
      <% end %>

      <% dropdown.with_item do %>
        <%= render SdrViewComponents::Elements::Navigation::DropdownHeaderComponent.new(text: 'Multiple items', classes: 'h4 text-body text-uppercase mt-3') %>
      <% end %>
      <% dropdown.with_item do %>
        <%= render SdrViewComponents::Elements::Navigation::DropdownLinkComponent.new(label: 'Register multiple items', link: new_multiple_item_path, disabled: !can_register_item?) %>
      <% end %>
      <% dropdown.with_item do %>
        <%= render SdrViewComponents::Elements::Navigation::DropdownLinkComponent.new(label: 'Register multiple items (via CSV)', link: new_bulk_actions_register_csv_path, disabled: !can_register_item?) %>
      <% end %>
      <% dropdown.with_item do %>
        <%= render SdrViewComponents::Elements::Navigation::DropdownLinkComponent.new(label: 'Deposit multiple items', link: multi_item_deposit_actions_path, disabled: !can_register_item?, data: { turbo_method: :post }) %>
      <% end %>
    <% end %>

    <%= render SdrViewComponents::Elements::Navigation::DropdownMenuComponent.new(text: 'Reports') do |dropdown| %>
      <% dropdown.with_item do %>
        <%= render SdrViewComponents::Elements::Navigation::DropdownLinkComponent.new(label: t('reports.title'), link: report_path) %>
      <% end %>
      <% dropdown.with_item do %>
        <%= render SdrViewComponents::Elements::Navigation::DropdownLinkComponent.new(label: 'Aggregate report', link: '#', disabled: true) %>
      <% end %>
    <% end %>

    <% if admin? || impersonating? %>
      <%= render SdrViewComponents::Elements::Navigation::DropdownMenuComponent.new(text: 'Admin') do |dropdown| %>
        <% if admin? %>
          <% dropdown.with_item do %>
            <%= render SdrViewComponents::Elements::Navigation::DropdownLinkComponent.new(label: 'Manage permissions', link: admin_workgroup_permissions_path) %>
          <% end %>
        <% end %>

        <% if show_impersonation_link? %>
          <% dropdown.with_item do %>
            <%= render SdrViewComponents::Elements::Navigation::DropdownLinkComponent.new(label: 'Impersonate', link: admin_impersonate_path, disabled: impersonating?) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if impersonating? %>
      <%= render SdrViewComponents::Elements::Navigation::NavItemComponent.new(text: 'Stop impersonating', path: admin_stop_impersonate_path, data: { turbo_method: :delete, turbo_confirm: 'Stop impersonating?' }) %>
    <% end %>

  <% end %>
<% end %>
