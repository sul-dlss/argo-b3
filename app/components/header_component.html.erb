<%= render SdrViewFoobars::Structure::HeaderFoobar.new(title: 'Argo: Build Back Better', variant: :dark, background_color: '84, 73, 72') do |header| %>
  <%= header.with_primary_navigation_link do %>
    <%= render SdrViewFoobars::Elements::Navigation::NavItemFoobar.new(text: 'Feedback', path: "mailto:#{Settings.support_email}") %>
    <%= render SdrViewFoobars::Elements::Navigation::NavItemFoobar.new(text: logged_in_text) %>
  <% end %>
  <%= header.with_secondary_navigation_link do %>
    <%= render SdrViewFoobars::Elements::Navigation::NavItemFoobar.new(text: 'Workflow status', path: workflow_grid_path) %>
    <%= render SdrViewFoobars::Elements::Navigation::DropdownMenuFoobar.new(text: 'Bulk actions') do |dropdown| %>
      <% dropdown.with_item do %>
        <%= render SdrViewFoobars::Elements::Navigation::DropdownLinkFoobar.new(label: 'Recent bulk actions', link: bulk_actions_path) %>
      <% end %>
      <% dropdown.with_item do %>
        <%= render SdrViewFoobars::Elements::Navigation::DropdownLinkFoobar.new(label: t('bulk_actions.menu'), link: new_bulk_action_path) %>
      <% end %>
    <% end %>

    <%= render SdrViewFoobars::Elements::Navigation::DropdownMenuFoobar.new(text: 'Register and deposit') do |dropdown| %>
      <% dropdown.with_item do %>
        <%= render SdrViewFoobars::Elements::Navigation::DropdownHeaderFoobar.new(text: 'Single object', classes: 'h4') %>
      <% end %>
      <% dropdown.with_item do %>
        <%= render SdrViewFoobars::Elements::Navigation::DropdownLinkFoobar.new(label: 'Item', link: new_item_path, disabled: !can_register_item?) %>
      <% end %>
      <% dropdown.with_item do %>
        <%= render SdrViewFoobars::Elements::Navigation::DropdownLinkFoobar.new(label: 'Collection', link: '#', disabled: true) %>
      <% end %>
      <% dropdown.with_item do %>
        <%= render SdrViewFoobars::Elements::Navigation::DropdownLinkFoobar.new(label: 'APO', link: new_apo_path, disabled: !can_register_apo?) %>
      <% end %>
      <% dropdown.with_item do %>
        <%= render SdrViewFoobars::Elements::Navigation::DropdownLinkFoobar.new(label: 'Agreement', link: '#', disabled: true) %>
      <% end %>

      <% dropdown.with_item do %>
        <%= render SdrViewFoobars::Elements::Navigation::DropdownHeaderFoobar.new(text: 'Multiple items', classes: 'h4') %>
      <% end %>
      <% dropdown.with_item do %>
        <%= render SdrViewFoobars::Elements::Navigation::DropdownLinkFoobar.new(label: 'Register multiple items', link: new_multiple_item_path, disabled: !can_register_item?) %>
      <% end %>
      <% dropdown.with_item do %>
        <%= render SdrViewFoobars::Elements::Navigation::DropdownLinkFoobar.new(label: 'Register multiple items for Goobi', link: '#', disabled: true) %>
      <% end %>
      <% dropdown.with_item do %>
        <%= render SdrViewFoobars::Elements::Navigation::DropdownLinkFoobar.new(label: 'Register multiple items (via CSV)', link: new_bulk_actions_register_csv_path, disabled: !can_register_item?) %>
      <% end %>
      <% dropdown.with_item do %>
        <%= render SdrViewFoobars::Elements::Navigation::DropdownLinkFoobar.new(label: 'Deposit multiple items', link: multi_item_deposit_actions_path, disabled: !can_register_item?, data: { turbo_method: :post }) %>
      <% end %>
    <% end %>

    <%= render SdrViewFoobars::Elements::Navigation::DropdownMenuFoobar.new(text: 'Reports') do |dropdown| %>
      <% dropdown.with_item do %>
        <%= render SdrViewFoobars::Elements::Navigation::DropdownLinkFoobar.new(label: 'Custom report', link: report_path) %>
      <% end %>
      <% dropdown.with_item do %>
        <%= render SdrViewFoobars::Elements::Navigation::DropdownLinkFoobar.new(label: 'Aggregate report', link: '#', disabled: true) %>
      <% end %>
    <% end %>

    <% if admin? || impersonating? %>
      <%= render SdrViewFoobars::Elements::Navigation::DropdownMenuFoobar.new(text: 'Admin') do |dropdown| %>
        <% if admin? %>
          <% dropdown.with_item do %>
            <%= render SdrViewFoobars::Elements::Navigation::DropdownLinkFoobar.new(label: 'Manage permissions', link: admin_workgroup_permissions_path) %>
          <% end %>
        <% end %>

        <% if show_impersonation_link? %>
          <% dropdown.with_item do %>
            <%= render SdrViewFoobars::Elements::Navigation::DropdownLinkFoobar.new(label: 'Impersonate', link: admin_impersonate_path, disabled: impersonating?) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if impersonating? %>
      <%= render SdrViewFoobars::Elements::Navigation::NavItemFoobar.new(text: 'Stop impersonating', path: admin_stop_impersonate_path, data: { turbo_method: :delete, turbo_confirm: 'Stop impersonating?' }) %>
    <% end %>

  <% end %>
<% end %>
