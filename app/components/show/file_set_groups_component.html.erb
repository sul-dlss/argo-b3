<% if grouped? %>
  <% groups.each do |group| %>
    <%= render SdrViewComponents::Elements::CollapsibleSectionComponent.new(id: group.id, heading: group.heading, level: :h3,
                                                                            heading_classes: 'text-uppercase', classes: 'mb-3') do %>
      <% group.indexed_content_file_sets.each do |content_file_set, index| %>
        <%= render Show::FileSetComponent.new(content_file_set:, content_file_set_counter: index,
                                              content_file_set_total: content_file_sets.size, classes: 'mb-2') %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <%= render Show::FileSetComponent.with_collection(content_file_sets, content_file_set_total: content_file_sets.size,
                                                                       classes: 'mb-2') %>
<% end %>
