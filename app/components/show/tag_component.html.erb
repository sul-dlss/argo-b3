<%= render Show::BoxComponent.new(heading: 'Tags') do %>
  <ul class="object-type-tag mb-0 dotted-underline-links">
    <% tags.each do |object_tag| %>
      <li>
        <span class="d-inline-flex align-items-end gap-1">
          <%= link_to object_tag, search_path_for(object_tag) %>
          <%= render Pin::PinnedTagComponent.new(tag: object_tag, pinned: pinned?(object_tag), compact: true) %>
        </span>
      </li>
    <% end %>
  </ul>
<% end %>
