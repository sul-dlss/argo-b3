<%= render SdrViewComponents::Tables::RawTableComponent.new(id: 'versions-table',
                                                            label: 'Versions',
                                                            show_label: false) do |component| %>
  <% component.with_header(label: 'Version') %>
  <% component.with_header(label: 'Description') %>
  <% component.with_header(label: 'Public version') if user_version_columns? %>
  <% component.with_header(label: 'Registered / opened') %>
  <% component.with_header(label: 'Deposited') %>
  <% component.with_header(label: 'Download') %>
  <% component.with_header(label: 'PURL') if user_version_columns? %>
  <% versions.each do |version| %>
    <% component.with_row do %>
      <%= render Show::VersionRowComponent.new(version:, cocina_object:, druid_token:,
                                               manage_user_versions: manage_user_versions?) %>
    <% end %>
  <% end %>
<% end %>
