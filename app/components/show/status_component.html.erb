<%= render Show::BoxComponent.new(heading:) do %>
  <% case status %>
  <% when :deposited, :draft %>
    <ul>
      <li><%= link_to I18n.t('show.status.actions.edit_item_details'), '#', class: 'pe-none text-muted', 'aria-disabled': 'true', tabindex: '-1' %></li>
      <li><%= link_to I18n.t('show.status.actions.manage_files'), '#', class: 'pe-none text-muted', 'aria-disabled': 'true', tabindex: '-1' %></li>
      <li><%= link_to I18n.t('show.status.actions.manage_description'), '#', class: 'pe-none text-muted', 'aria-disabled': 'true', tabindex: '-1' %></li>
    </ul>
  <% when :depositing %>
    <p><%= I18n.t('show.status.depositing.body') %></p>
  <% when :error %>
    <% workflow_error_messages.each do |workflow_error_message| %>
      <p><%= workflow_error_message %></p>
    <% end %>
  <% end %>
<% end %>
