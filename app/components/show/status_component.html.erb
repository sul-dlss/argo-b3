<%= render Show::BoxComponent.new(heading:) do %>
  <% case status %>
  <% when :deposited, :draft %>
    <div class="d-flex flex-wrap justify-content-center gap-3 mt-4">
      <% if edit? %>
        <%= render SdrViewComponents::Elements::ButtonLinkComponent.new(link: edit_path, label: edit_label,
                                                                        variant: :'outline-primary', size: :sm) %>
      <% else %>
        <%= render SdrViewComponents::Elements::ButtonComponent.new(label: edit_label,
                                                                    variant: :'outline-primary', size: :sm,
                                                                    disabled: true) %>
      <% end %>
      <%= render manage_files_button if manage_files? %>
      <% if status == :draft %>
        <%= render SdrViewComponents::Elements::ButtonComponent.new(label: I18n.t('show.status.actions.deposit'),
                                                                    variant: :primary, size: :sm, disabled: true) %>
      <% end %>
    </div>
  <% when :staging, :assembling, :depositing %>
    <p><%= I18n.t('show.status.depositing.body') %></p>
  <% when :staging_failed %>
    <p><%= staging_failed_body %></p>
    <%# Managing files again retries staging. %>
    <div class="d-flex flex-wrap justify-content-center gap-3 mt-4">
      <%= render manage_files_button %>
    </div>
  <% when :error %>
    <% workflow_error_messages.each do |workflow_error_message| %>
      <p><%= workflow_error_message %></p>
    <% end %>
  <% end %>
<% end %>
