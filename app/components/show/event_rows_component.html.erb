<%= render SdrViewComponents::Tables::RowComponent.new(label: when_label, values: [event_type_label, who, version, toggle_indicator], **toggle_row_options) %>
<% if data? %>
  <%= render SdrViewComponents::Tables::RowComponent.new(id: data_id, class: 'event-data collapse') do |row_component| %>
    <% row_component.with_cell(colspan: 5) do %>
      <dl class="row mb-0">
        <% display_data.each do |key, value| %>
          <dt class="col-sm-3"><%= key_label(key) %></dt>
          <dd class="col-sm-9">
            <% if json?(value) %>
              <%= render Elements::JsonViewerComponent.new(hash: value, expanded: 1, show_toolbar: false) %>
            <% else %>
              <%= value %>
            <% end %>
          </dd>
        <% end %>
      </dl>
    <% end %>
  <% end %>
<% end %>
