<%= tag.tr(id: row_id, **toggle_row_options) do %>
  <td><%= toggle_button %></td>
  <th class="col-3" scope="row"><%= when_label %></th>
  <td><%= event_type_label %></td>
  <td><%= who %></td>
  <td><%= version %></td>
<% end %>
<% if data? %>
  <%= render SdrViewComponents::Tables::RowComponent.new(id: data_id, class: 'toggle-row-data collapse') do |row_component| %>
    <% row_component.with_cell(colspan: 5) do %>
      <dl class="row mb-0">
        <% display_data.each do |key, value| %>
          <dt class="col-sm-3"><%= key_label(key) %></dt>
          <dd class="col-sm-9">
            <% if json?(value) %>
              <%= render Elements::JsonViewerComponent.new(hash: value, expanded: 1, show_toolbar: false) %>
            <% else %>
              <%= value %>
            <% end %>
          </dd>
        <% end %>
      </dl>
    <% end %>
  <% end %>
<% end %>
