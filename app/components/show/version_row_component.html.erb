<%= render SdrViewComponents::Tables::RowComponent.new do |row| %>
  <% row.with_cell do %><%= version %><% end %>
  <% row.with_cell do %><%= description %><% end %>
  <% if user_version_columns? %>
    <% row.with_cell do %>
      <div class="d-flex align-items-center justify-content-between gap-2">
        <%= user_version_label %>
        <% if withdrawable? %>
          <%= render user_version_button_component('Withdraw', withdraw_object_user_version_path(**user_version_path_params)) %>
        <% elsif restorable? %>
          <%= render user_version_button_component('Restore', restore_object_user_version_path(**user_version_path_params)) %>
        <% end %>
      </div>
    <% end %>
  <% end %>
  <% row.with_cell do %><%= helpers.format_datetime(opened_at) %><% end %>
  <% row.with_cell do %><%= helpers.format_datetime(accessioned_at) %><% end %>
  <% row.with_cell do %>
    <% if cocina? %>
      <%= render SdrViewComponents::Tables::ListCellComponent.new(item_values: download_links) %>
    <% end %>
  <% end %>
  <% if user_version_columns? %>
    <% row.with_cell do %><%= purl_link %><% end %>
  <% end %>
<% end %>
