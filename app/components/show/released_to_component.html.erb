<%= render Show::BoxComponent.new(heading:) do |box| %>
  <% if release? %>
    <% box.with_heading_action do %>
      <%= render SdrViewComponents::Elements::IconButtonLinkComponent.new(icon: :edit, label: 'Manage release',
                                                                          link: new_item_release_path(solr_doc.druid)) %>
    <% end %>
  <% end %>
  <% if release_tag_links.any? %>
    <ul class="dotted-underline-links">
      <% release_tag_links.each do |release_tag_link| %>
        <li><%= helpers.link_to_new_tab(release_tag_link[:label], release_tag_link[:url]) %></li>
      <% end %>
    </ul>
  <% end %>
<% end %>
