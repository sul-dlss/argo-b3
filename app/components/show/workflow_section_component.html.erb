<%= render SdrViewComponents::Elements::CollapsibleSectionComponent.new(id: collapse_id, expanded: expanded?,
                                                                        classes: 'workflow-section', heading_classes: 'workflow-section-heading') do |component| %>
  <% component.with_heading_content do %>
    <%= workflow_name %>
    <% if complete? %>
      <span class="text-success"><%= helpers.success_icon(aria: { hidden: true }) %> Complete</span>
    <% else %>
      <span class="workflow-in-progress"><%= helpers.in_progress_icon(aria: { hidden: true }) %> In progress</span>
    <% end %>
  <% end %>
  <div class="workflow-section-body">
    <% version_groups = workflow.processes.group_by(&:version) %>
    <% version_groups.keys.sort.reverse_each do |version| %>
      <%= render Show::WorkflowTableComponent.new(workflow:, version:, processes: version_groups[version], solr_doc:) %>
    <% end %>
  </div>
<% end %>
