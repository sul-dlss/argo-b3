<div class="mb-4">
  <div class="d-flex flex-wrap align-items-baseline column-gap-4 mb-2">
    <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h3, text: t('multi_item_deposit.discovery_summary.heading'), classes: 'mb-0') %>
    <span><%= t('multi_item_deposit.discovery_summary.started', started_at:) %></span>
  </div>
  <div class="d-flex flex-wrap gap-3">
    <div class="summary-box">
      <div class="summary-box-label"><%= t('multi_item_deposit.discovery_summary.item_count') %></div>
      <div class="summary-box-value"><%= item_count %></div>
    </div>
    <%= tag.div class: ['summary-box', error_classes] do %>
      <div class="summary-box-label"><%= t('multi_item_deposit.discovery_summary.error_count') %></div>
      <div class="summary-box-value"><%= error_count %></div>
    <% end %>
    <% if content_types %>
      <div class="summary-box">
        <div class="summary-box-label"><%= t('multi_item_deposit.discovery_summary.content_types') %></div>
        <div class="summary-box-value summary-box-value-text"><%= content_types %></div>
      </div>
    <% end %>
  </div>
</div>
