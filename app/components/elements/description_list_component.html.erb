<dl class="row">
  <% entries.each do |key, value| %>
    <%= tag.dt term_label(key), class: term_classes %>
    <%= tag.dd class: description_classes do %>
      <% values_for(value).each do |item| %>
        <% if item.is_a?(Hash) %>
          <%= render Elements::DescriptionListComponent.new(hash: item, nested: true) %>
        <% else %>
          <div><%= item %></div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</dl>
