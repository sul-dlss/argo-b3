<dl class="row">
  <% entries.each do |key, value| %>
    <dt class="<%= term_classes %>"><%= term_label(key) %></dt>
    <dd class="<%= description_classes %>">
      <% values_for(value).each do |item| %>
        <% if item.is_a?(Hash) %>
          <%= render Elements::DescriptionListComponent.new(hash: item, nested: true) %>
        <% else %>
          <div><%= item %></div>
        <% end %>
      <% end %>
    </dd>
  <% end %>
</dl>
