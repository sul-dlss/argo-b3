<%# The json is an attribute (not content), since the viewer re-renders on attribute changes (e.g., from a morph). %>
<%= tag.andypf_json_viewer indent: 3,
                           expanded:,
                           theme: 'cupertino',
                           'show-data-types': false,
                           'show-toolbar': show_toolbar,
                           'expand-icon-type': 'arrow',
                           'show-copy': true,
                           'show-size': false,
                           'preserve-expanded': false,
                           'expand-empty': false,
                           data: hash %>
<% if show_tip %>
  <p class="mt-2"><small><em>Tip: Shift + Click to expand/collapse all nodes.</em></small></p>
<% end %>
