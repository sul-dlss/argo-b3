<%= tag.div class: classes do %>
  <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h2, classes: 'mb-0', text: title) %>
  <% if help_text.present? %>
    <p class="mb-0"><small><%= help_text %></small></p>
  <% end %>
  <div class="mt-3">
    <% buttons.each do |button| %><%= button %><% end %>
  </div>
<% end %>
