<li class="d-inline-flex gap-5 align-items-center my-2 me-2">
  <span class="bg-light badge rounded-pill border selected-item">
    <span class="selected-item-label"><%= label_content || label %></span>
    <%# btn-close draws the X, so the icon is hidden; variant: nil keeps the close-button look. %>
    <%= render SdrViewComponents::Elements::IconButtonLinkComponent.new(icon: :remove, label: "Remove #{label}", link:, classes: 'btn-close', icon_classes: 'd-none', variant: nil) %>
  </span>
</li>
