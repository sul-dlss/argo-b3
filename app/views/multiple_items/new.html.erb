<div class="container py-2">
  <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h1, text: t('edit.multiple_items.new.title'), classes: 'mb-3') %>
  <%= form_with(model: @items_registration_form, url: multiple_items_path, class: 'b3-form') do |form| %>
    <%= render Edit::ContentTypeComponent.new(form:) %>

    <%= render SdrViewComponents::Elements::HorizontalRuleComponent.new %>

    <%= render Edit::ApoComponent.new(form:, options: @apo_options) %>

    <%= render SdrViewComponents::Elements::HorizontalRuleComponent.new %>

    <%= render Edit::AccessAndEmbargoComponent.new(form:) %>

    <%= render SdrViewComponents::Elements::HorizontalRuleComponent.new %>

    <%= render Edit::UseAndReproductionStatementComponent.new(form:, container_classes: 'my-fieldset') %>

    <%= render Edit::CopyrightComponent.new(form:, container_classes: 'my-fieldset') %>

    <%= render SdrViewComponents::Elements::HorizontalRuleComponent.new %>

    <%= render Edit::LicenseComponent.new(form:, container_classes: 'my-fieldset') %>

    <%= render SdrViewComponents::Elements::HorizontalRuleComponent.new %>

    <%= render SdrViewComponents::Forms::FieldsetComponent.new(classes: 'my-fieldset',
                                                               hidden_label: true,
                                                               label: t('edit.items.fields.goobi.deposit')) do %>
      <div class="row align-items-center">
        <div class="col-3 form-label fw-bold" aria-hidden="true"><%= t('edit.items.fields.goobi.deposit') %></div>
        <div class="col-auto form-check">
          <%= form.radio_button :deposit_with_goobi, 'true', class: 'form-check-input' %>
          <%= form.label :deposit_with_goobi_true, 'Yes', class: 'form-check-label' %>
        </div>
        <div class="col-auto form-check">
          <%= form.radio_button :deposit_with_goobi, 'false', class: 'form-check-input' %>
          <%= form.label :deposit_with_goobi_false, 'No', class: 'form-check-label' %>
        </div>
      </div>
    <% end %>

    <%= render SdrViewComponents::Elements::HorizontalRuleComponent.new %>

    <%= render Edit::TagsComponent.new(form:) %>

    <%= render SdrViewComponents::Elements::HorizontalRuleComponent.new %>

    <div id="item-registrations">
    <% if @items_registration_form.invalid_item_registrations.blank? %>
      <%= render SdrViewComponents::Forms::FieldsetComponent.new(data: { controller: 'radio' },
                                                                 classes: 'my-fieldset',
                                                                 label: 'How do you want to enter items?') do %>
      <%= render SdrViewComponents::Forms::RadioButtonComponent.new(form:, field_name: :items_choice,
                                                                    container_classes: 'my-fieldset',
                                                                    label_text: 'Upload CSV from computer',
                                                                    input_value: ItemsRegistrationForm::UPLOAD_CSV_CHOICE,
                                                                    input_data: { radio_target: 'radio', action: 'radio#toggle' }) do |component| %>
        <%= component.with_additional_container_content do %>
          <%= render SdrViewComponents::Forms::FileComponent.new(form:,
                                                                 field_name: :csv_file,
                                                                 container_classes: 'my-fieldset',
                                                                 label_text: 'Upload a CSV file',
                                                                 label_hidden: true) %>
        <% end %>
      <% end %>

      <%= render SdrViewComponents::Forms::RadioButtonComponent.new(form:, field_name: :items_choice,
                                                                    container_classes: 'my-fieldset',
                                                                    label_text: 'Enter a tab-delimited list of Barcode, FOLIO Instance HRID, Source ID, and Title',
                                                                    input_value: ItemsRegistrationForm::ENTER_TAB_DELIMITED_CHOICE,
                                                                    input_data: { radio_target: 'radio', action: 'radio#toggle' }) do |component| %>
        <%= component.with_additional_container_content do %>
          <%= render SdrViewComponents::Forms::TextAreaComponent.new(form:,
                                                                     container_classes: 'my-fieldset',
                                                                     field_name: :tab_delimited_items,
                                                                     label_text: 'Enter tab-delimited list',
                                                                     label_hidden: true,
                                                                     input_rows: 5) %>
        <% end %>
      <% end %>

      <%= render SdrViewComponents::Forms::RadioButtonComponent.new(form:, field_name: :items_choice,
                                                                    label_text: 'Enter each item individually. Either FOLIO Instance HRID or Title is required.',
                                                                    input_value: ItemsRegistrationForm::ENTER_EACH_CHOICE,
                                                                    input_data: { radio_target: 'radio', action: 'radio#toggle' }) do |component| %>
        <%= component.with_additional_container_content do %>
          <%= render SdrViewComponents::Forms::InvalidFeedbackComponent.new(form:, field_name: :item_registrations) %>

          <%= render Elements::Forms::HasManyComponent.new(form:, field_name: :item_registrations,
                                                           form_component: Edit::ItemRegistrationComponent,
                                                           container_classes: 'my-fieldset',
                                                           add_button_label: 'Add another item') %>
        <% end %>
      <% end %>
      <% end %>
    <% else %>
      <%= render SdrViewComponents::Elements::AlertComponent.new(variant: :danger) do %>
        <%= t('edit.multiple_items.new.invalid_items_alert',
              register_label: t('edit.multiple_items.new.buttons.register'),
              clear_label: t('edit.multiple_items.new.buttons.clear')) %>
      <% end %>
      <%= tag.div class: 'my-fieldset', data: { controller: 'has-many' } do %>
        <div data-has-many-target="container">
          <%= form.fields_for :item_registrations do |nested_form| %>
            <% if nested_form.object.errors.any? %>
              <%= render Elements::Forms::HasManyRowComponent.new(form: nested_form,
                                                                  form_component: Edit::ItemRegistrationComponent) %>
            <% else %>
              <%= nested_form.hidden_field :title %>
              <%= nested_form.hidden_field :source_id %>
              <%= nested_form.hidden_field :barcode %>
              <%= nested_form.hidden_field :catalog_record_id %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>
    </div>

    <div class="d-flex align-items-center mt-5">
      <%= render SdrViewComponents::Elements::ButtonLinkComponent.new(label: 'Cancel', link: root_path, variant: :link, classes: 'me-3') %>
      <%= render SdrViewComponents::Forms::SubmitComponent.new(label: t('edit.multiple_items.new.buttons.clear'), variant: 'outline-primary', value: MultipleItemsController::CLEAR_VALUE, classes: 'me-3') if @items_registration_form.invalid_item_registrations.any? %>
      <%= render SdrViewComponents::Forms::SubmitComponent.new(label: t('edit.multiple_items.new.buttons.register')) %>
    </div>
  <% end %>
</div>
