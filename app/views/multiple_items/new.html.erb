<%= render Layout::ContainerComponent.new(heading: t('edit.multiple_items.new.title')) do %>
  <%= form_with(model: @items_registration_form, url: multiple_items_path, class: 'b3-form',
                data: { controller: 'content-type-dependent' }) do |form| %>
    <%= render Edit::ContentTypeComponent.new(form:, input_data: { content_type_dependent_target: 'contentType',
                                                                   action: 'content-type-dependent#toggle' }) %>

    <%= render Edit::ViewingDirectionComponent.new(form:, container_classes: 'my-fieldset', label_classes: 'fw-bold',
                                                   container_data: { content_type_dependent_target: 'dependent',
                                                                     content_type_dependent_allowed: Constants::CONTENT_TYPES_WITH_VIEWING_DIRECTIONS }) %>

    <%= render SdrViewComponents::Elements::HorizontalRuleComponent.new %>

    <%# Selecting an APO applies its object defaults to the rights fields. %>
    <%= tag.div data: { controller: 'apo-defaults', apo_defaults_apply_on_connect_value: @apply_apo_defaults_on_connect } do %>
      <%= render Edit::ApoComponent.new(form:, options: @apo_options, apo_defaults: true) %>

      <%= render Edit::CollectionsComponent.new(form:, options: @collection_options) %>

      <%= render SdrViewComponents::Elements::HorizontalRuleComponent.new %>

      <%= render Edit::AccessAndEmbargoComponent.new(form:, apo_defaults: true) %>

      <%= render SdrViewComponents::Elements::HorizontalRuleComponent.new %>

      <%= render Edit::UseAndReproductionStatementComponent.new(form:, container_classes: 'my-fieldset',
                                                                apo_defaults: true) %>

      <%= render Edit::CopyrightComponent.new(form:, container_classes: 'my-fieldset', apo_defaults: true) %>

      <%= render SdrViewComponents::Elements::HorizontalRuleComponent.new %>

      <%= render Edit::LicenseComponent.new(form:, container_classes: 'my-fieldset', apo_defaults: true) %>
    <% end %>

    <%= render SdrViewComponents::Elements::HorizontalRuleComponent.new %>

    <%# The floated legend is a flex item, so it is the row's first column. %>
    <%= render SdrViewComponents::Forms::FieldsetComponent.new(classes: 'my-fieldset row align-items-center pt-2',
                                                               label: t('edit.items.fields.goobi.deposit'),
                                                               label_classes: 'mb-0', legend_classes: 'col-3 mb-0',
                                                               data: { content_type_dependent_target: 'dependent',
                                                                       content_type_dependent_allowed: Constants::GOOBI_CONTENT_TYPES }) do %>
      <%= render SdrViewComponents::Forms::RadioButtonComponent.new(form:, field_name: :deposit_with_goobi,
                                                                    container_classes: 'col-auto d-flex align-items-center gap-2',
                                                                    input_classes: 'order-first ms-0',
                                                                    label_text: 'Yes', input_value: 'true') %>
      <%= render SdrViewComponents::Forms::RadioButtonComponent.new(form:, field_name: :deposit_with_goobi,
                                                                    container_classes: 'col-auto d-flex align-items-center gap-2',
                                                                    input_classes: 'order-first ms-0',
                                                                    label_text: 'No', input_value: 'false') %>
    <% end %>

    <%= render SdrViewComponents::Elements::HorizontalRuleComponent.new %>

    <%= render Edit::TagsComponent.new(form:) %>

    <%= render SdrViewComponents::Elements::HorizontalRuleComponent.new %>

    <div id="item-registrations">
    <% if @items_registration_form.invalid_item_registrations.blank? %>
      <%= render SdrViewComponents::Forms::RadioButtonGroupComponent.new(form:, field_name: :items_choice,
                                                                         data: { controller: 'radio' },
                                                                         classes: 'my-fieldset',
                                                                         label: 'How do you want to enter items?') do |group| %>
      <% group.with_radio_button(container_classes: 'my-fieldset',
                                 label_text: 'Upload CSV from computer',
                                 input_value: ItemsRegistrationForm::UPLOAD_CSV_CHOICE,
                                 input_data: { radio_target: 'radio', action: 'radio#toggle' }) do %>
        <%= render SdrViewComponents::Forms::FileComponent.new(form:,
                                                               field_name: :csv_file,
                                                               container_classes: 'my-fieldset',
                                                               label_text: 'Upload a CSV file',
                                                               label_hidden: true) %>
      <% end %>

      <% group.with_radio_button(container_classes: 'my-fieldset',
                                 label_text: 'Enter a tab-delimited list of Barcode, FOLIO Instance HRID, Source ID, and Title',
                                 input_value: ItemsRegistrationForm::ENTER_TAB_DELIMITED_CHOICE,
                                 input_data: { radio_target: 'radio', action: 'radio#toggle' }) do %>
        <%= render SdrViewComponents::Forms::TextAreaComponent.new(form:,
                                                                   container_classes: 'my-fieldset',
                                                                   field_name: :tab_delimited_items,
                                                                   label_text: 'Enter tab-delimited list',
                                                                   label_hidden: true,
                                                                   input_rows: 5) %>
      <% end %>

      <% group.with_radio_button(label_text: 'Enter each item individually. Either FOLIO Instance HRID or Title is required.',
                                 input_value: ItemsRegistrationForm::ENTER_EACH_CHOICE,
                                 input_data: { radio_target: 'radio', action: 'radio#toggle' }) do %>
        <%= render SdrViewComponents::Forms::InvalidFeedbackComponent.new(form:, field_name: :item_registrations) %>

        <%= render Elements::Forms::HasManyComponent.new(form:, field_name: :item_registrations,
                                                         form_component: Edit::ItemRegistrationComponent,
                                                         container_classes: 'my-fieldset',
                                                         add_button_label: 'Add another item') %>
      <% end %>
      <% end %>
    <% else %>
      <%= render SdrViewComponents::Elements::AlertComponent.new(variant: :danger) do %>
        <%= t('edit.multiple_items.new.invalid_items_alert',
              register_label: t('edit.multiple_items.new.buttons.register'),
              clear_label: t('edit.multiple_items.new.buttons.clear')) %>
      <% end %>
      <%= tag.div class: 'my-fieldset', data: { controller: 'has-many' } do %>
        <div data-has-many-target="container">
          <%= form.fields_for :item_registrations do |nested_form| %>
            <% if nested_form.object.errors.any? %>
              <%= render Elements::Forms::HasManyRowComponent.new(form: nested_form,
                                                                  form_component: Edit::ItemRegistrationComponent) %>
            <% else %>
              <%= nested_form.hidden_field :title %>
              <%= nested_form.hidden_field :source_id %>
              <%= nested_form.hidden_field :barcode %>
              <%= nested_form.hidden_field :catalog_record_id %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>
    </div>

    <%= render Elements::FormFooterComponent.new(cancel_path: root_path) do %>
      <%= render SdrViewComponents::Forms::SubmitComponent.new(label: t('edit.multiple_items.new.buttons.clear'), variant: 'outline-primary', value: MultipleItemsController::CLEAR_VALUE) if @items_registration_form.invalid_item_registrations.any? %>
      <%= render SdrViewComponents::Forms::SubmitComponent.new(label: t('edit.multiple_items.new.buttons.register')) %>
    <% end %>
  <% end %>
<% end %>
