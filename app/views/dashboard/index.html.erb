<%= content_for :title, 'Dashboard' %>

<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
<% end %>

<div class="container mt-3">
  <%= render Structure::TwoColumnWithHeaderComponent.new do |layout| %>
    <% layout.with_top_content do %>
      <div class="row">
        <div class="col-xl-2 col-lg-12 pt-3">
          <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h1, text: 'Argo dashboard') %>
        </div>

        <% if I18n.t('banner.dashboard_html').present? %>
          <div class="col-xl-10 col-lg-12">
            <%= render SdrViewComponents::Elements::AlertComponent.new(variant: :info, dismissible: true) do %>
              <%= t('banner.dashboard_html') %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
    <% layout.with_left_content do %>
      <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h2, classes: 'mb-0', text: 'Go to a druid') %>
      <%= form_with model: @go_to_druid_form, url: go_to_druid_path, class: 'mb-5' do |form| %>
          <div class="d-flex">
            <%= render SdrViewComponents::Forms::TextFieldComponent.new(form:,
                                                                        field_name: :druid,
                                                                        label_hidden: true,
                                                                        input_placeholder: 'Enter druid here') %>
            <%= render SdrViewComponents::Forms::SubmitComponent.new(label: 'Go', classes: 'ms-2', style: 'width: fit-content;') %>
          </div>
      <% end %>

      <%= render Elements::ButtonListComponent.new(title: 'Register & deposit single object') do |component| %>
        <% component.with_button(link: new_item_path, label: 'Item', variant: 'outline-primary', disabled: !allowed_to?(:new?, nil, with: ItemPolicy)) %>
        <% component.with_button(link: '#', label: 'Collection', variant: 'outline-primary', disabled: true) %>
        <% component.with_button(link: '#', label: 'APO', variant: 'outline-primary', disabled: true) %>
        <% component.with_button(link: '#', label: 'Agreement', variant: 'outline-primary', disabled: true) %>
      <% end %>

      <%= render Elements::ButtonListComponent.new(title: 'Register or deposit multiple items', classes: 'mt-4') do |component| %>
        <% component.with_button(link: '#', label: 'Register multiple items', variant: 'outline-primary', disabled: true) %>
        <% component.with_button(link: '#', label: 'Deposit multiple items', variant: 'outline-primary', disabled: true) %>
        <% component.with_button(link: '#', label: 'Register items for Goobi', variant: 'outline-primary', disabled: true) %>
      <% end %>

      <%= render Elements::ButtonListComponent.new(title: 'Admin', classes: 'mt-4') do |component| %>
        <% component.with_button(link: '#', label: 'Manage permissions', variant: 'outline-primary', disabled: true) if allowed_to?(:manage_permissions?, nil, with: AdminPolicy) %>
        <% component.with_button(link: '#', label: 'Impersonate', variant: 'outline-primary', disabled: true) if allowed_to?(:impersonate?, nil, with: AdminPolicy) %>
      <% end %>
    <% end %>
    <% layout.with_main_content do %>
      <% if Rails.env.development? %>
        <%= render SdrViewComponents::Elements::AlertComponent.new(title: 'Development environment connections', dismissible: true, variant: :note, classes: 'mt-2') do %>
          <p>Solr: <%= Settings.solr.url %> | DSA: <%= Settings.dor_services.url %></p>
        <% end %>
      <% end %>

      <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h2, text: 'My recent activity', classes: 'mt-3') %>

      <%= render SdrViewComponents::Tables::TableComponent.new(classes: 'mb-5', responsive: true) do |component| %>
        <% component.with_caption do %>
          <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h3, text: 'Recent objects') %>
        <% end %>
        <% component.with_header(label: 'Title') %>
        <% component.with_header(label: 'Druid') %>
        <% component.with_header(label: 'Object type') %>
        <% component.with_header(label: 'Tags') %>
        <% component.with_row(values: ['Wiedoeft, Rudy Liver and bacon: fox trot: Emerson Records, New York...', 'bb234ab1234', 'Item', 'Project : Riegler-Deutsch Index']) %>
        <% component.with_row(values: ['1947 Partition', 'bb234ab123', 'APO', nil]) %>
      <% end %>

      <div class="mb-5">
        <%= render Dashboard::PinnedSearchesTableComponent.new(pinned_searches: @pinned_searches) %>
      </div>

      <div class="mb-5">
        <%= render Dashboard::PinnedItemsTableComponent.new(pinned_item_docs: @pinned_item_docs) %>
      </div>

      <div class="mb-5">
        <%= render Dashboard::PinnedCollectionsTableComponent.new(pinned_collection_docs: @pinned_collection_docs) %>
      </div>

      <div class="mb-5">
        <%= render Dashboard::PinnedAposTableComponent.new(pinned_apo_docs: @pinned_apo_docs) %>
      </div>

      <%= render Dashboard::PinnedVirtualObjectsTableComponent.new(pinned_virtual_object_docs: @pinned_virtual_object_docs) %>
    <% end %>
  <% end %>
</div>
