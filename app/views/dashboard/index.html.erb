<%= page_title(t('dashboard.heading')) %>

<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
<% end %>

<%= render Layout::ContainerComponent.new(data: { controller: 'preserve-collapsed-sections' }) do %>
  <%= render Layout::TwoColumnWithHeaderComponent.new do |layout| %>
    <% layout.with_top_content do %>
      <div class="row">
        <div class="col-xl-2 col-lg-12 pt-3">
          <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h1, text: t('dashboard.heading'), classes: 'mb-3') %>
        </div>

        <%= render Dashboard::BannerComponent.new(text: t('banner.dashboard_html')) %>
      </div>
    <% end %>
    <% layout.with_left_content do %>
      <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h2, classes: 'mb-0', text: t('dashboard.go_to_druid.heading')) %>
      <%= form_with model: @go_to_druid_form, url: go_to_druid_path, class: 'mb-5' do |form| %>
          <div class="d-flex">
            <%= render SdrViewComponents::Forms::TextFieldComponent.new(form:,
                                                                        field_name: :druid,
                                                                        label_hidden: true) %>
            <%= render SdrViewComponents::Forms::SubmitComponent.new(label: t('dashboard.go_to_druid.submit'), classes: 'ms-2', style: 'width: fit-content;') %>
          </div>
      <% end %>

      <%= render Elements::ButtonListComponent.new(title: t('dashboard.register_single.heading')) do |component| %>
        <% component.with_button(link: new_item_path, label: t('dashboard.register_single.item'), variant: 'outline-primary', disabled: !allowed_to?(:new?, nil, with: ItemPolicy)) %>
        <% component.with_button(link: new_collection_path, label: t('dashboard.register_single.collection'), variant: 'outline-primary', disabled: !allowed_to?(:new?, nil, with: CollectionPolicy)) %>
        <% component.with_button(link: new_apo_path, label: t('dashboard.register_single.apo'), variant: 'outline-primary', disabled: !allowed_to?(:new?, nil, with: ApoPolicy)) %>
        <% component.with_button(link: new_agreement_path, label: t('dashboard.register_single.agreement'), variant: 'outline-primary', disabled: !allowed_to?(:new?, nil, with: AgreementPolicy)) %>
      <% end %>

      <%= render Elements::ButtonListComponent.new(title: t('dashboard.register_multiple.heading'), classes: 'mt-4') do |component| %>
        <% component.with_button(link: new_multiple_item_path, label: t('dashboard.register_multiple.register_items'), variant: 'outline-primary', disabled: !allowed_to?(:new?, nil, with: ItemPolicy)) %>
        <% component.with_button(link: new_bulk_actions_register_csv_path, label: t('dashboard.register_multiple.register_csv'), variant: 'outline-primary', disabled: !allowed_to?(:new?, nil, with: ItemPolicy)) %>
        <% component.with_button(link: multi_item_deposit_actions_path, method: :post, label: t('dashboard.register_multiple.deposit_items'), variant: 'outline-primary', disabled: !allowed_to?(:new?, nil, with: ItemPolicy)) %>
      <% end %>

      <% if allowed_to?(:admin?, nil, with: AdminPolicy) %>
        <%= render Elements::ButtonListComponent.new(title: t('dashboard.admin.heading'), classes: 'mt-4') do |component| %>
          <% component.with_button(link: admin_workgroup_permissions_path, label: t('dashboard.admin.manage_permissions'), variant: 'outline-primary') if allowed_to?(:manage_permissions?, nil, with: AdminPolicy) %>
          <% component.with_button(link: admin_impersonate_path, label: t('dashboard.admin.impersonate'), variant: 'outline-primary', disabled: Current.impersonating?) %>
        <% end %>
      <% end %>
    <% end %>
    <% layout.with_main_content do %>
      <% if Rails.env.development? %>
        <%= render SdrViewComponents::Elements::AlertComponent.new(title: t('dashboard.development.heading'), dismissible: true, variant: :note, classes: 'mt-2') do %>
          <p><%= t('dashboard.development.connections', solr_url: Settings.solr.url, dsa_url: Settings.dor_services.url) %></p>
        <% end %>
      <% end %>

      <%= render Dashboard::RecentObjectsTableComponent.new(recent_object_docs: @recent_object_docs) %>

      <%= render Dashboard::MultiItemDepositsTableComponent.new(multi_item_deposit_actions: @recent_multi_item_deposit_actions) %>

      <%= render Dashboard::RecentDraftsAndDepositsTableComponent.new(
            object_docs: @recent_draft_and_deposit_docs,
            statuses: @recent_draft_and_deposit_statuses,
            search_form: @recent_drafts_and_deposits_search_form
          ) %>

      <%= render Dashboard::PinnedSearchesTableComponent.new(pinned_searches: @pinned_searches) %>

      <%= render Dashboard::PinnedItemsTableComponent.new(pinned_item_docs: @pinned_item_docs) %>

      <%= render Dashboard::PinnedCollectionsTableComponent.new(pinned_collection_docs: @pinned_collection_docs) %>

      <%= render Dashboard::PinnedAposTableComponent.new(pinned_apo_docs: @pinned_apo_docs) %>

      <%= render Dashboard::PinnedTagsTableComponent.new(pinned_tags: @pinned_tags) %>

      <%= render Dashboard::PinnedVirtualObjectsTableComponent.new(pinned_virtual_object_docs: @pinned_virtual_object_docs) %>
    <% end %>
  <% end %>
<% end %>
