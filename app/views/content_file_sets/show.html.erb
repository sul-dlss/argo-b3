<%= turbo_frame_tag @content_file_set do %>
  <%= render Elements::FlashToastComponent.new %>
  <% if @files_deleted %>
    <%= tag.div data: { controller: 'dropzone-files-reload', dropzone_files_reload_dropzone_files_outlet: '.dropzone-files' } %>
  <% end %>
  <%= render Show::FileSetComponent.new(content_file_set: @content_file_set, content_token: @content_token, content_file_set_counter: @counter) %>
<% end %>
