<%= render layout: 'contents/step_layout', locals: { title: @solr_doc.title, manage_files_flow: @manage_files_flow } do %>
  <%# The item form has no fields on this step; the footer's buttons submit it. %>
  <%= render SdrViewComponents::TabForm::HiddenFieldsFormComponent.new(model: @contents_item_form, url: content_path(@contents_item_form.druid), id: 'item_form') %>

  <div class="b3-form">
    <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h2, text: t('edit.contents.steps.files'), classes: 'mb-3') %>

    <%# Not submitted; the choice only shows the selected way of adding files. %>
    <%= fields_for :content_form, @content_form do |form| %>

      <%= render SdrViewComponents::Forms::RadioButtonGroupComponent.new(
            form:,
            field_name: :file_location_choice,
            label: t('edit.items.fields.file_choice.label'),
            mark_required: true,
            data: { controller: 'radio', action: 'turbo:frame-load->radio#refresh' }
          ) do |group| %>

        <% group.with_radio_button(
             label_text: t('edit.items.fields.file_choice.upload.label'),
             input_value: ContentForm::UPLOAD_FILE_LOCATION_CHOICE,
             input_data: { radio_target: 'radio', action: 'radio#toggle' },
             container_classes: 'my-fieldset'
           ) do %>
          <%= form_with model: @content,
                        url: content_dropzone_path(@content_token),
                        data: {
                          controller: 'dropzone',
                          dropzone_max_filesize_value: Settings.file_upload.max_filesize,
                          dropzone_reloadable_frame_outlet: '.content-files-frame',
                          action: 'radio:disable->dropzone#disable radio:enable->dropzone#enable ' \
                                  'disable-actions:disable->dropzone#disable disable-actions:enable->dropzone#enable',
                          disable_actions_target: 'disableable'
                        }, id: 'file-dropzone', class: 'dropzone radio-disableable my-fieldset' do %>
            <%= render SdrViewComponents::Elements::AlertComponent.new(classes: 'd-none', data: { dropzone_target: 'folderAlert' }) do %>
              <span data-dropzone-target="folderAlertText"></span>
              <%= render SdrViewComponents::Elements::ButtonComponent.new(label: 'Reset', variant: 'outline-primary', classes: 'ms-3', data: { action: 'dropzone#clearBasePath' }) %>
            <% end %>
            <%= render SdrViewComponents::Elements::ProgressBarComponent.new(label: 'Upload progress', classes: 'd-none', data: { dropzone_target: 'progress' }) %>
            <%# The alert region stays in the page so that added errors are announced. %>
            <div role="alert">
              <ul data-dropzone-target="error" class="d-none list-unstyled text-danger"></ul>
            </div>
            <div class="dz-message">
              <div class="fs-1"><%= cloud_upload_icon(aria: { hidden: true }) %></div>
              <div class="fs-5">Drag and drop your files here, up to 10GB or 25,000 files.</div>
              <div class="fs-5">or</div>
              <%= render SdrViewComponents::Elements::ButtonComponent.new(label: 'Select files to upload', variant: :'outline-primary', classes: 'mt-2') %>
            </div>
            <div id="dropzone-hidden-input-container"></div>
          <% end %>
        <% end %>

        <% group.with_radio_button(
             label_text: t('edit.items.fields.file_choice.globus.label'),
             input_value: ContentForm::GLOBUS_FILE_LOCATION_CHOICE,
             input_data: { radio_target: 'radio', action: 'radio#toggle', disable_actions_target: 'disableable' },
             container_classes: 'my-fieldset'
           ) do %>
          <div class="my-fieldset">
            <%# Loaded when the radio is selected (see radio controller), since it calls the Globus API. %>
            <%= turbo_frame_tag @content, 'globus', data: { radio_src: new_content_globus_path(@content_token) } do %>
              <%= render Elements::RosetteSpinnerComponent.new(size: :small, message: t('edit.contents.globus.checking')) %>
            <% end %>
          </div>
        <% end %>

        <% group.with_radio_button(
             label_text: t('edit.items.fields.file_choice.mount.label'),
             input_value: ContentForm::MOUNT_FILE_LOCATION_CHOICE,
             input_data: { radio_target: 'radio', action: 'radio#toggle', disable_actions_target: 'disableable' },
             container_classes: 'my-fieldset'
           ) do %>
          <div class="my-fieldset">
            <%= turbo_frame_tag @content, 'mount', src: new_content_mount_path(@content_token) do %>
              <%= render SdrViewComponents::Elements::SpinnerComponent.new %>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <%= render SdrViewComponents::Elements::HorizontalRuleComponent.new %>

      <%# The heading, with the number of files, is in the frame so that it updates when the frame reloads. %>
      <%= turbo_frame_tag @content, 'show', src: content_path(@content_token), data: { controller: 'reloadable-frame' }, class: 'content-files-frame' do %>
        <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h2, text: t('edit.contents.edit.files_section.label')) %>
        <%= render SdrViewComponents::Elements::SpinnerComponent.new %>
        <%# Until the files section has loaded, assume there are unassociated files. %>
        <span hidden data-unassociated-files-target="unassociated"></span>
      <% end %>
    <% end %>

    <div class="mt-5">
      <%= render Item::ManageFilesStepFooterComponent.new(manage_files_flow: @manage_files_flow, form_id: 'item_form', druid: @contents_item_form.druid,
                                                          content_token: @content_token, draft_actions_presenter: @draft_actions_presenter, files_required: true) %>
    </div>
  </div>
<% end %>
