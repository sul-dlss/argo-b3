<div class="container py-2" data-controller="unassociated-files">
  <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h1, text: t('edit.contents.edit.title')) %>

  <p class="mb-4"><%= @solr_doc.title %></p>

  <% form_id = 'tabbed_form' %>

  <%= render SdrViewComponents::TabForm::HiddenFieldsFormComponent.new(model: @content, id: form_id) %>

  <%= render SdrViewComponents::TabForm::TabListComponent.new(id: form_id, active_tab_name: :add_files) do |tab_list| %>
    <% tab_list.with_tab(label: t('edit.contents.tabs.add_files.label'), tab_name: :add_files) %>
    <% tab_list.with_tab(label: t('edit.contents.tabs.structural.label'), tab_name: :structural) %>
    <% tab_list.with_tab(label: t('edit.contents.tabs.deposit.label'), tab_name: :deposit, mark_required: true) %>

    <% tab_list.with_pane(SdrViewComponents::TabForm::PaneComponent.new(tab_name: :add_files,
                                                                        label: t('edit.contents.tabs.add_files.label'))) do %>
      <%= turbo_frame_tag @content, 'edit' do %>
        <%= form_with model: @content,
                      url: content_path(@content_token),
                      data: {
                        controller: 'dropzone',
                        dropzone_max_filesize_value: Settings.file_upload.max_filesize,
                        dropzone_dropzone_files_outlet: '.dropzone-files'
                      }, id: 'file-dropzone', class: 'dropzone mb-3' do |form| %>
          <%= render SdrViewComponents::Elements::AlertComponent.new(classes: 'd-none', data: { dropzone_target: 'folderAlert' }) do %>
            <span data-dropzone-target="folderAlertText"></span>
            <%= render SdrViewComponents::Elements::ButtonComponent.new(label: 'Reset', variant: 'outline-primary', classes: 'ms-3', data: { action: 'dropzone#clearBasePath' }) %>
          <% end %>
          <%= render SdrViewComponents::Elements::ProgressBarComponent.new(label: 'Upload progress', classes: 'd-none', data: { dropzone_target: 'progress' }) %>
          <ul data-dropzone-target="error" class="d-none list-unstyled text-danger"></ul>
          <div class="dz-message">
            <div class="fs-1"><%= cloud_upload_icon %></div>
            <div class="fs-5">Drag and drop your files here, up to 10GB or 25,000 files.</div>
            <div class="fs-5">or</div>
            <%= render SdrViewComponents::Elements::ButtonComponent.new(label: 'Select files to upload', variant: :'outline-primary', classes: 'mt-2') %>
          </div>
          <div id="dropzone-hidden-input-container"></div>
      <% end %>

      <%= render SdrViewComponents::Elements::HorizontalRuleComponent.new %>

      <%= turbo_frame_tag @content, 'show', src: content_path(@content_token), data: { controller: 'dropzone-files' }, class: 'dropzone-files' do %>
        <%= render SdrViewComponents::Elements::SpinnerComponent.new %>
      <% end %>
    <% end %>
                                                                          <% end %>
    <% tab_list.with_pane(SdrViewComponents::TabForm::PaneComponent.new(tab_name: :structural,
                                                                        label: t('edit.contents.tabs.structural.label'))) do %>
      <%= turbo_frame_tag @content, 'edit-structure', src: edit_content_structure_path(@content_token), data: { controller: 'dropzone-files' }, class: 'dropzone-files' do %>
        <%= render SdrViewComponents::Elements::SpinnerComponent.new %>
        <%# Until the structure section has loaded, assume there are unassociated files. %>
        <span hidden data-unassociated-files-target="unassociated"></span>
      <% end %>
    <% end %>

    <% tab_list.with_pane(SdrViewComponents::TabForm::PaneComponent.new(tab_name: :deposit,
                                                                        label: t('edit.contents.tabs.deposit.label'),
                                                                        mark_required: true)) do %>
      <div class="d-flex justify-content-end">
        <%= form_with url: item_path(@content.druid), method: :patch do %>
          <%= render SdrViewComponents::Forms::SubmitComponent.new(label: t('edit.contents.edit.buttons.draft'), value: ItemsController::DRAFT_VALUE, variant: 'outline-primary', classes: 'me-2', data: { unassociated_files_target: 'submit' }) %>
          <%= render SdrViewComponents::Forms::SubmitComponent.new(label: t('edit.contents.edit.buttons.deposit'), value: ItemsController::DEPOSIT_VALUE, data: { unassociated_files_target: 'submit' }) %>
        <% end %>
      </div>
    <% end %>

  <% end %>
</div>
