<%= turbo_frame_tag @content, 'show' do %>
  <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h2,
                                                               text: t('edit.contents.edit.files_section.heading',
                                                                       file_count: number_with_delimiter(@content.content_file_binaries.count))) %>
  <%# Disables the actions (e.g., cancel, deposit) while discovering or staging (see disable-actions in contents/edit).
      The frame is reloaded when discovery starts and finishes. %>
  <% if @content.staging_or_discovering? %>
    <span hidden data-disable-actions-target="busy"></span>
  <% end %>
  <%# Deleting is disabled during discovery, since discovery may be adding files. %>
  <%# The fieldset is disabled while uploading and structuring (see disable-actions in contents/edit). %>
  <fieldset data-disable-actions-target="disableable">
    <%= render Edit::ContentFileBinariesComponent.new(content_record: @content,
                                                      content_token: @content_token,
                                                      disabled: @content.discovering?) %>
  </fieldset>
<% end %>
