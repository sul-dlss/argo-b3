<%= turbo_frame_tag @content, 'show' do %>
  <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h2,
                                                               text: t('edit.contents.edit.files_section.heading',
                                                                       file_count: number_with_delimiter(@content.content_file_binaries.count))) %>
  <%# Disables the actions (e.g., cancel, deposit) while busy, e.g., from a stale page (see disable-actions in contents/files). %>
  <% if @content.busy? %>
    <span hidden data-disable-actions-target="busy"></span>
  <% end %>
  <%# Enables proceeding to the next step once there are files (see files-required in contents/files). %>
  <% if @content.content_file_binaries.any? %>
    <span hidden data-files-required-target="file"></span>
  <% end %>
  <%# Disables saving while there are files that are not in a resource (see unassociated-files in contents/files). %>
  <% if @content.content_file_binaries.unassociated.any? %>
    <span hidden data-unassociated-files-target="unassociated"></span>
  <% end %>
  <%# The fieldset is disabled while uploading (see disable-actions in contents/files). %>
  <fieldset data-disable-actions-target="disableable">
    <%= render Edit::ContentFileBinariesComponent.new(content_record: @content,
                                                      content_token: @content_token,
                                                      disabled: @content.busy?) %>
  </fieldset>
<% end %>
