<%= page_title(t('edit.items.edit.title'), name: @title) %>

<%= render Layout::ContainerComponent.new(heading: t('edit.items.edit.title'), subtitle: @title) do %>

  <% form_id = 'tabbed_form' %>

  <%# enctype is necessary to support file upload. %>
  <%# Rails normally handles magically, but doesn't because the file input isn't nested in the form. %>
  <%= render SdrViewComponents::TabForm::HiddenFieldsFormComponent.new(model: @edit_item_form, id: form_id, url: item_path(@edit_item_form.druid),
                                                                       hidden_fields: [:lock], html_options: { enctype: 'multipart/form-data' }) %>

  <%# Change events from fields in the panes bubble up here, clearing the validation errors reported by the
      previous submission once the user edits the offending field. %>
  <%= render Layout::TabListComponent.new(id: form_id, active_tab_name: :details,
                                          data: { action: 'change->sdr-tab-error#changed' }) do |tab_list| %>
    <% tab_list.with_tab(label: t('edit.items.tabs.details.label'), tab_name: :details, mark_required: true) %>
    <% tab_list.with_tab(label: t('edit.items.tabs.description.label'), tab_name: :description, mark_required: true) %>
    <% tab_list.with_tab(label: t('edit.items.tabs.rights.label'), tab_name: :rights, mark_required: true) %>
    <% tab_list.with_tab(label: t('edit.items.edit.tabs.deposit.label'), tab_name: :deposit, mark_required: true) %>

    <% form_with(model: @edit_item_form, url: item_path(@edit_item_form.druid), html: { id: form_id }, builder: SdrViewComponents::TabForm::TabbedFormBuilder) do |form| %>
      <% tab_list.with_pane(SdrViewComponents::TabForm::PaneComponent.new(tab_name: :details,
                                                                          label: t('edit.items.tabs.details.label'),
                                                                          mark_required: true)) do |pane| %>
        <%= render SdrViewComponents::Forms::TextFieldComponent.new(
              form:,
              field_name: :source_id,
              label_text: t('edit.items.fields.source_id.label'),
              label_mark_required: true
            ) %>
        <% pane.with_footer do %>
          <%= render Item::EditTabFooterComponent.new(pane:, form_id: form.id, cancel_path: object_path(@druid), druid: @druid, draft_actions_presenter: @draft_actions_presenter, show_previous: false) %>
        <% end %>
      <% end %>

      <% tab_list.with_pane(SdrViewComponents::TabForm::PaneComponent.new(tab_name: :description,
                                                                          label: t('edit.items.tabs.description.label'),
                                                                          mark_required: true)) do |pane| %>

        <%= render Edit::DescriptionComponent.new(form:, druid_token: @druid_token) %>

        <% pane.with_footer do %>
          <%= render Item::EditTabFooterComponent.new(pane:, form_id: form.id, cancel_path: object_path(@druid), druid: @druid, draft_actions_presenter: @draft_actions_presenter, show_previous: true) %>
        <% end %>
      <% end %>

      <% tab_list.with_pane(SdrViewComponents::TabForm::PaneComponent.new(tab_name: :rights,
                                                                          label: t('edit.items.tabs.rights.label'),
                                                                          mark_required: true)) do |pane| %>
        <%# The selected APO's object defaults are shown with the rights fields, but are applied to them only when the
            user clicks the apply defaults button, so that the item's rights are not overwritten. %>
        <%= tag.div data: { controller: 'apo-defaults', apo_defaults_apply_on_connect_value: false } do %>
          <%= render Edit::ApoComponent.new(form:, options: @apo_options, apo_defaults: true, apply_defaults_button: true) %>

          <%= render Edit::CollectionsComponent.new(form:, options: @collection_options) %>

          <%= render SdrViewComponents::Elements::HorizontalRuleComponent.new %>

          <%= render Edit::AccessAndEmbargoComponent.new(form:, apo_defaults: true, overwrite_file_access: true) %>

          <%= render SdrViewComponents::Elements::HorizontalRuleComponent.new %>

          <%= render Edit::UseAndReproductionStatementComponent.new(form:, container_classes: 'my-fieldset',
                                                                    apo_defaults: true) %>

          <%= render Edit::CopyrightComponent.new(form:, container_classes: 'my-fieldset', apo_defaults: true) %>

          <%= render SdrViewComponents::Elements::HorizontalRuleComponent.new %>

          <%= render Edit::LicenseComponent.new(form:, container_classes: 'my-fieldset', apo_defaults: true) %>
        <% end %>

        <% pane.with_footer do %>
          <%= render Item::EditTabFooterComponent.new(pane:, form_id: form.id, cancel_path: object_path(@druid), druid: @druid, draft_actions_presenter: @draft_actions_presenter) %>
        <% end %>
      <% end %>

      <% tab_list.with_pane(SdrViewComponents::TabForm::PaneComponent.new(tab_name: :deposit,
                                                                          label: t('edit.items.edit.tabs.deposit.label'),
                                                                          mark_required: true)) do |pane| %>
        <%= render Edit::VersionDescriptionComponent.new(form:) %>
        <%= render SdrViewComponents::Forms::InvalidFeedbackComponent.new(field_name: :content, form:, classes: 'mb-3') %>

        <% pane.with_footer do %>
          <%= render Item::EditTabFooterComponent.new(pane:, form_id: form.id, cancel_path: object_path(@druid), druid: @druid, draft_actions_presenter: @draft_actions_presenter, show_next: false, show_edit_files: true, show_deposit: true) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

<% end %>
