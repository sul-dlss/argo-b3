<div class="container py-2">
  <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h1, text: t('edit.items.new.title'), classes: 'mb-3') %>

  <% form_id = 'tabbed_form' %>

  <%# enctype is necessary to support file upload. %>
  <%# Rails normally handles magically, but doesn't because the file input isn't nested in the form. %>
  <%= render SdrViewComponents::TabForm::HiddenFieldsFormComponent.new(model: @new_item_form, id: form_id, url: items_path,
                                                                       html_options: { enctype: 'multipart/form-data' }) %>

  <%# Change events from fields in the panes bubble up here, clearing the validation errors reported by the
      previous submission once the user edits the offending field. %>
  <%= render SdrViewComponents::TabForm::TabListComponent.new(id: form_id, active_tab_name: :details,
                                                              data: { action: 'change->sdr-tab-error#changed' }) do |tab_list| %>
    <% tab_list.with_tab(label: t('edit.items.tabs.details.label'), tab_name: :details, mark_required: true) %>
    <% tab_list.with_tab(label: t('edit.items.tabs.description.label'), tab_name: :description, mark_required: true) %>
    <% tab_list.with_tab(label: t('edit.items.tabs.rights.label'), tab_name: :rights, mark_required: true) %>
    <% tab_list.with_tab(label: t('edit.items.tabs.tags.label'), tab_name: :tags) %>
    <% tab_list.with_tab(label: t('edit.items.tabs.release.label'), tab_name: :release) %>
    <% tab_list.with_tab(label: t('edit.items.tabs.deposit.label'), tab_name: :deposit, mark_required: true) %>

    <% form_with(model: @new_item_form, url: items_path, html: { id: form_id }, builder: SdrViewComponents::TabForm::TabbedFormBuilder) do |form| %>
      <% tab_list.with_pane(SdrViewComponents::TabForm::PaneComponent.new(tab_name: :details,
                                                                          label: t('edit.items.tabs.details.label'),
                                                                          mark_required: true)) do |pane| %>
        <%= render Edit::SourceIdChoiceComponent.new(form:) %>

        <%= render Edit::ContentTypeComponent.new(form:, container_classes: 'mb-3') %>
        <% pane.with_footer do %>
          <%= render Item::TabNavigationComponent.new(pane:, show_previous: false, cancel_path: @cancel_path) %>
        <% end %>
      <% end %>

      <% tab_list.with_pane(SdrViewComponents::TabForm::PaneComponent.new(tab_name: :description,
                                                                          label: t('edit.items.tabs.description.label'),
                                                                          mark_required: true)) do |pane| %>

        <%= render Edit::DescriptionChoiceComponent.new(form:) %>

        <% pane.with_footer do %>
          <%= render Item::TabNavigationComponent.new(pane:, show_previous: false, cancel_path: @cancel_path) %>
        <% end %>
      <% end %>

      <% tab_list.with_pane(SdrViewComponents::TabForm::PaneComponent.new(tab_name: :rights,
                                                                          label: t('edit.items.tabs.rights.label'),
                                                                          mark_required: true)) do |pane| %>
        <%# Selecting an APO applies its object defaults to the rights fields. The defaults of the initially selected
            APO are also applied to a new form, but not to a form redisplayed with errors, which keeps the user's values. %>
        <%= tag.div data: { controller: 'apo-defaults', apo_defaults_apply_on_connect_value: @new_item_form.errors.empty? } do %>
          <%= render Edit::ApoComponent.new(form:, options: @apo_options, apo_defaults: true) %>

          <%= render Edit::CollectionsComponent.new(form:, options: @collection_options) %>

          <%= render SdrViewComponents::Elements::HorizontalRuleComponent.new %>

          <%= render Edit::AccessAndEmbargoComponent.new(form:, apo_defaults: true) %>

          <%= render SdrViewComponents::Elements::HorizontalRuleComponent.new %>

          <%= render Edit::UseAndReproductionStatementComponent.new(form:, container_classes: 'my-fieldset',
                                                                    apo_defaults: true) %>

          <%= render Edit::CopyrightComponent.new(form:, container_classes: 'my-fieldset', apo_defaults: true) %>

          <%= render SdrViewComponents::Elements::HorizontalRuleComponent.new %>

          <%= render Edit::LicenseComponent.new(form:, container_classes: 'my-fieldset', apo_defaults: true) %>
        <% end %>

        <% pane.with_footer do %>
          <%= render Item::TabNavigationComponent.new(pane:, cancel_path: @cancel_path) %>
        <% end %>
      <% end %>

      <% tab_list.with_pane(SdrViewComponents::TabForm::PaneComponent.new(tab_name: :tags,
                                                                          label: t('edit.items.tabs.tags.label'))) do |pane| %>
        <%= render Edit::TagsComponent.new(form:) %>

        <% pane.with_footer do %>
          <%= render Item::TabNavigationComponent.new(pane:, cancel_path: @cancel_path) %>
        <% end %>
      <% end %>

      <% tab_list.with_pane(SdrViewComponents::TabForm::PaneComponent.new(tab_name: :release,
                                                                          label: t('edit.items.tabs.release.pane'),
                                                                          help_text: t('edit.items.tabs.release.help_text'))) do |pane| %>
        <%= render SdrViewComponents::Forms::HasOneComponent.new(form:,
                                                                 field_name: :release_tags,
                                                                 form_component: Edit::ReleaseTagsComponent,
                                                                 fieldset_label: t('edit.items.tabs.release.pane')) %>

        <% pane.with_footer do %>
          <%= render Item::TabNavigationComponent.new(pane:, cancel_path: @cancel_path) %>
        <% end %>
      <% end %>

      <% tab_list.with_pane(SdrViewComponents::TabForm::PaneComponent.new(tab_name: :deposit,
                                                                          label: t('edit.items.tabs.deposit.label'),
                                                                          help_text: t('edit.items.tabs.deposit.help_text'),
                                                                          mark_required: true)) do |pane| %>
        <% pane.with_footer do %>
          <div class="d-flex">
            <%= render Item::TabNavigationComponent.new(pane:, show_next: false, cancel_path: @cancel_path) %>
            <%= render SdrViewComponents::Forms::SubmitComponent.new(
                  label: t('edit.items.new.buttons.register_add_files'),
                  form_id: form.id,
                  value: ItemsController::DRAFT_TO_ADD_FILES_VALUE,
                  classes: 'ms-auto'
                ) %>
            <%= render SdrViewComponents::Forms::SubmitComponent.new(
                  label: t('edit.items.new.buttons.register'),
                  form_id: form.id,
                  value: ItemsController::DRAFT_VALUE,
                  variant: 'outline-primary',
                  classes: 'ms-2'
                ) %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

</div>
