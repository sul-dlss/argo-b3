<%= turbo_frame_tag(@druid, 'events') do %>
  <%# The form is permanent so that the filter values (and Tom Select) are retained when the frame reloads.
      The id is per object so another object's form isn't retained. %>
  <%= form_with model: @events_filter_form, url: events_object_path(druid: params[:druid]), method: :get,
                id: "events_filter_#{DruidSupport.bare_druid_from(@druid)}", class: 'row g-3 align-items-end mb-4',
                data: { turbo_permanent: true, turbo_frame: "#{@druid}_events" } do |form| %>
    <%= render SdrViewComponents::Forms::TextFieldComponent.new(form:, field_name: :from, label_text: 'From', input_type: 'datetime-local',
                                                                container_classes: 'col-md-3') %>
    <%= render SdrViewComponents::Forms::TextFieldComponent.new(form:, field_name: :to, label_text: 'To', input_type: 'datetime-local',
                                                                container_classes: 'col-md-3') %>
    <%= render Elements::Forms::MultiSelectFilterComponent.new(form:, field_name: :event_types,
                                                               options: @event_types.map { |event_type| [event_type.humanize, event_type] },
                                                               label_text: 'Event types', container_classes: 'col-md-4') %>
    <div class="col-md-2">
      <%= render SdrViewComponents::Forms::SubmitComponent.new(label: 'Filter') %>
    </div>
  <% end %>

  <% if @events.empty? %>
    <p>No events.</p>
  <% else %>
    <%= render Show::EventsTableComponent.new(events: @events) %>
  <% end %>
<% end %>
