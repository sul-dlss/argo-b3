<%= page_title(t('reports.title')) %>

<%= render Layout::ContainerComponent.new(heading: t('reports.title'), data: { controller: 'report', report_preview_url_value: preview_report_path }) do %>
  <%= form_with model: @report_form, url: download_report_path do |form| %>
    <%= render BulkActions::SelectSourceComponent.new(
          form:, search_form: @last_search_form, total_results: @total_results, example_druids: @example_druids,
          label: 'Select source of items for report',
          radio_action: 'report#update',
          druids_radio_data: { report_target: 'sourceRadio' },
          druid_list_data: { report_target: 'druidListInput', action: 'input->report#updateSubmit change->report#update' }
        ) %>

    <fieldset class="mt-4" data-controller="checkbox-select">
      <legend>Select fields to include in report:</legend>

      <div class="mb-2">
        <%= render SdrViewComponents::Elements::ButtonComponent.new(label: 'Select all', variant: :link, classes: 'p-0 align-baseline fw-bold',
                                                                    data: { action: 'click->checkbox-select#checkAll' }) %>
        |
        <%= render SdrViewComponents::Elements::ButtonComponent.new(label: 'Deselect all', variant: :link, classes: 'p-0 align-baseline fw-bold',
                                                                    data: { action: 'click->checkbox-select#checkNone' }) %>
      </div>

      <div class="row">
        <div class="col">
          <%= render Report::FieldsSectionComponent.new(form:, label: 'Frequently used', field_configs: ReportsController::FREQUENTLY_USED_FIELDS) %>
        </div>

        <div class="col">
          <%= render Report::FieldsSectionComponent.new(form:, label: 'Citation', field_configs: ReportsController::CITATION_FIELDS) %>
          <%= render Report::FieldsSectionComponent.new(form:, label: 'History', field_configs: ReportsController::HISTORY_FIELDS, classes: 'mt-3') %>
        </div>

        <div class="col">
          <%= render Report::FieldsSectionComponent.new(form:, label: 'Identifiers', field_configs: ReportsController::IDENTIFIERS_FIELDS) %>
          <%= render Report::FieldsSectionComponent.new(form:, label: 'Content', field_configs: ReportsController::CONTENT_FIELDS, classes: 'mt-3') %>
        </div>
      </div>
    </fieldset>

    <%= render Elements::FormFooterComponent.new(classes: 'mb-3') do %>
      <%= render SdrViewComponents::Forms::SubmitComponent.new(value: 'Download', variant: :primary, formtarget: '_blank') do %>
        <%= new_tab_label('Download') %>
      <% end %>
    <% end %>
  <% end %>

  <%= render SdrViewComponents::Elements::HorizontalRuleComponent.new(classes: 'my-4') %>

  <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h2, variant: :h3, text: 'Preview', classes: 'mt-4') %>
  <p>The first <%= ReportsController::PREVIEW_ROWS %> rows of the report, updated when you change the source or fields.</p>
  <div class="visually-hidden" role="status" data-report-target="status"></div>
  <%= turbo_frame_tag 'report-preview', data: { report_target: 'preview' } %>
  <template data-report-target="loadingTemplate">
    <%= render SdrViewComponents::Elements::SpinnerComponent.new(message: 'Loading preview...') %>
  </template>
  <template data-report-target="errorTemplate">
    <%= render SdrViewComponents::Elements::AlertComponent.new(variant: :danger, text: 'The preview could not be loaded. Change a field to try again.') %>
  </template>
<% end %>
