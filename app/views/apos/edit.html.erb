<%= render Layout::ContainerComponent.new(heading: t('edit.apos.edit.title'), subtitle: @title) do %>

  <%= form_with(model: @edit_apo_form, url: apo_path(@druid), method: :patch, class: 'b3-form') do |form| %>
    <%= form.hidden_field :lock %>

    <%= render Edit::ApoFieldsComponent.new(form:, agreement_options: @agreement_options) %>

    <%= render Edit::VersionDescriptionComponent.new(form:, label_classes: 'fw-bold', container_classes: 'my-field') %>

    <div class="d-flex align-items-center mt-5">
      <%= render SdrViewComponents::Elements::ButtonLinkComponent.new(label: 'Cancel', link: object_path(@druid), variant: :link, classes: 'me-3') %>
      <%= render SdrViewComponents::Forms::SubmitComponent.new(label: t('edit.apos.edit.buttons.deposit')) %>
    </div>
  <% end %>
<% end %>
