<%= turbo_frame_tag 'items-search' do %>
  <% if @results.any? %>
    <section aria-label="Item, collection, and APO results">
      <% heading_text = "Item, collection, and APO results (#{number_with_delimiter(@results.total_results)} found)" %>
      <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h2, variant: :h3, text: heading_text) %>

      <%# proc that takes a page number and returns the path for that page, used for pagination %>
      <nav class="d-flex sort-pagination d-md-flex justify-content-between" aria-label="Pagination and sorting controls">
        <% path_func = ->(page) { search_items_path(@search_form.with_attributes(page:)) } %>
        <%= render Elements::Pagination::BriefComponent.new(total_pages: @results.total_pages, current_page: @results.page, path_func:, total_results: @results.total_results, per_page: @results.per_page) %>

        <%= render Search::SortComponent.new(search_form: @search_form) %>
      </nav>

      <ul class="list-unstyled">
        <%= render Search::ItemResultComponent.with_collection(@results, pinned_object_druids: @pinned_object_druids) %>
      </ul>

      <%= render Elements::Pagination::FullComponent.new(total_pages: @results.total_pages, current_page: @results.page, path_func:) %>
    </section>
  <% end %>

  <%= render Search::DebugComponent.new(search_form: @search_form, results: @results) %>

  <%= render Search::FacetTurboStreamReplaceComponent.with_collection(Search::Facets::PRIMARY, results: @results, search_form: @search_form) %>
<% end %>
