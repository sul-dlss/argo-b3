<div class="container" data-controller="workflow-grid">
  <%= form_with url: workflow_grid_path, method: :get do |form| %>
    <fieldset>
      <legend>Select scope for workflow grid:</legend>

      <%= render SdrViewComponents::Forms::RadioButtonComponent.new(form:, field_name: :scope,
                                                                    label_text: 'All items',
                                                                    input_value: 'all',
                                                                    input_checked: @scope == 'all') %>

      <%= render SdrViewComponents::Forms::RadioButtonComponent.new(form:, field_name: :scope,
                                                                    label_text: 'From last search',
                                                                    input_value: 'last_search',
                                                                    input_disabled: !defined?(@last_search_form),
                                                                    input_checked: @scope == 'last_search') do |component| %>
        <% if defined?(@last_search_form) %>
          <%= component.with_additional_container_content do %>
            <p><%= @total_results %> items for: <%= @last_search_form.to_s %></p>
          <% end %>
        <% end %>
      <% end %>

      <%= render SdrViewComponents::Forms::SubmitComponent.new(label: 'Go', variant: :primary) %>
    </fieldset>
  <% end %>

  <%= render WorkflowGrid::WorkflowTablesComponent.new(templates: @templates, search_form: @search_form, scope: @scope, workflow_process_counts: @workflow_process_counts) %>
</div>
