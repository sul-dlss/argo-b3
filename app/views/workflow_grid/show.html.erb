<%= content_for :title, t('workflow_grid.label') %>

<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
<% end %>

<div class="container my-2">
  <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h1, text: t('workflow_grid.label'), classes: 'mb-4') %>

  <%= render Search::CurrentFiltersComponent.new(search_form: @search_form, pinned: false, facet_labels: @facet_labels) %>

  <%= render Search::LayoutComponent.new do |layout| %>
    <%= layout.with_main_content do %>
      <%= render Search::ViewToggleComponent.new(search_form: @search_form) %>

      <%= render WorkflowGrid::WorkflowTablesComponent.new(templates: @templates, search_form: @search_form, workflow_process_counts: @workflow_process_counts) %>

      <%# Populates the facets in the sidebar. See Searchers::SecondaryFacet. %>
      <%= turbo_frame_tag 'items-search-secondary', src: secondary_facets_workflow_grid_items_path(@search_form.attributes) %>
    <% end %>

    <%= layout.with_sidebar do %>
      <%= render Search::FacetsSectionComponent.new(search_form: @search_form) %>
    <% end %>
  <% end %>
</div>
