<%= form_with model: @bulk_action_form, url: @bulk_action_config.create_path do |form| %>
  <%= render BulkActions::FormComponent.new(bulk_action_config: @bulk_action_config, form:) do %>
    <%= render BulkActions::SelectSourceComponent.new(form:, search_form: @last_search_form, total_results: @total_results, example_druids: @example_druids) %>

    <%= render LanguageSelectorComponent.new(form:) %>

    <%= render SdrViewComponents::Elements::AlertComponent.new(variant: :info, classes: 'mt-2') do %>
      <p>Do not run this process for images that contain no printed or typed text. This process will not overwrite OCR files
        that were generated outside SDR or that have been corrected to comply with accessibility standards.</p>
      <% if Sdr::TextExtraction.speech_to_text_types.any? %>
        <p>Do not auto-generate captions/transcripts for media files that do not contain any speech or lyrics.</p>
      <% end %>
    <% end %>
  <% end %>
<% end %>
