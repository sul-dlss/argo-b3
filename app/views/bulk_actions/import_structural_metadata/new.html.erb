<%= form_with model: @bulk_action_form, url: bulk_actions_import_structural_metadata_path do |form| %>
  <%= render BulkActions::FormComponent.new(bulk_action_config: @bulk_action_config, form:, with_close_version: true) do |component| %>
    <%= render SdrViewComponents::Forms::FileComponent.new(form:,
                                                           field_name: :csv_file,
                                                           label_text: 'Upload a CSV or Excel file',
                                                           label_classes: 'fw-bold',
                                                           variant: :help_text_below,
                                                           help_text: 'The spreadsheet must have the columns of the structural metadata export (an export can be edited and uploaded). Files can be reordered, regrouped, changed, or removed (by deleting their rows), but not added.') %>
  <% end %>
<% end %>
