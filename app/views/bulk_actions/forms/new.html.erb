<%# Default form for a bulk action without its own new view: a CSV upload or a druid list / last search. %>
<%= form_with model: @bulk_action_form, url: @bulk_action_config.create_path do |form| %>
  <%= render BulkActions::FormComponent.new(bulk_action_config: @bulk_action_config, form:) do %>
    <% if @bulk_action_form.is_a?(BulkActions::BasicCsvForm) %>
      <%= render SdrViewComponents::Forms::FileComponent.new(form:,
                                                             field_name: :csv_file,
                                                             label_text: 'Upload a CSV or Excel file',
                                                             label_classes: 'fw-bold') %>
    <% else %>
      <%= render BulkActions::SelectSourceComponent.new(form:, search_form: @last_search_form, total_results: @total_results, example_druids: @example_druids) %>
    <% end %>
  <% end %>
<% end %>
