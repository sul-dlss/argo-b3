<%= form_with model: @bulk_action_form, url: bulk_actions_import_read_unrestricted_workgroups_path do |form| %>
  <%= render BulkActions::FormComponent.new(bulk_action_config: @bulk_action_config, form:) do |component| %>
    <%= render SdrViewComponents::Forms::FileComponent.new(form:,
                                                           field_name: :csv_file,
                                                           label_text: 'Upload a CSV or Excel file',
                                                           label_classes: 'fw-bold') %>

    <p class="mt-2">
      The CSV should have the following headers. Values are required for every row:
    </p>
    <ul>
      <li><em>workgroup</em></li>
      <li>
        <em>read_unrestricted</em>
        (value should be <em>true</em> to grant the permission or <em>false</em> to revoke it)
      </li>
    </ul>
    <p>
      Only the workgroups in the CSV are affected. Other workgroups are left alone.
    </p>
  <% end %>
<% end %>
