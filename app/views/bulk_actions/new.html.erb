<%= page_title(t('bulk_actions.menu')) %>

<%= render Layout::ContainerComponent.new(heading: t('bulk_actions.heading')) do %>
  <%= render BulkActions::TabsComponent.new(active: :menu) %>

  <%# Sections read row by row in the three-column layout. %>
  <div class="row mt-2 gy-3">
    <% available_bulk_action_sections.each do |section, bulk_action_configs| %>
      <%= render BulkActions::ListSectionComponent.new(label: BulkActions.section_label(section), classes: 'col-lg-4 col-md-6', bulk_action_configs:) %>
    <% end %>
  </div>
<% end %>
