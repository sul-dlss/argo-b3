<%= form_with model: @bulk_action_form, url: bulk_actions_update_governing_apo_path do |form| %>
  <%= render BulkActions::FormComponent.new(bulk_action_config: @bulk_action_config, form:, with_close_version: true) do %>
    <%= render SdrViewComponents::Forms::SelectFieldComponent.new(form:, field_name: :new_apo_id,
                                                                  options: @apo_options,
                                                                  label_text: 'New governing APO',
                                                                  label_mark_required: true) %>

    <%= render BulkActions::SelectSourceComponent.new(form:, search_form: @last_search_form,
                                                      total_results: @total_results) %>
  <% end %>
<% end %>
