<%= form_with model: @bulk_action_form, url: @bulk_action_config.create_path do |form| %>
  <%= render BulkActions::FormComponent.new(bulk_action_config: @bulk_action_config, form:) do %>
    <%= render SdrViewComponents::Forms::SelectFieldComponent.new(form:, field_name: :new_apo_id,
                                                                  options: @apo_options,
                                                                  label_text: 'New governing APO',
                                                                  label_classes: 'fw-bold',
                                                                  label_mark_required: true) %>

    <%= render BulkActions::SelectSourceComponent.new(form:, search_form: @last_search_form,
                                                      total_results: @total_results, example_druids: @example_druids) %>
  <% end %>
<% end %>
