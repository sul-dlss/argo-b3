<%# PROTOTYPE (throwaway, never merge): floating variant switcher and sample toast; development only. %>
<% if Rails.env.development? %>
  <% keys = NotificationsPrototypeHelper::PROTOTYPE_VARIANTS.keys %>
  <% index = keys.index(prototype_variant) %>
  <% prev_key = keys[(index - 1) % keys.size] %>
  <% next_key = keys[(index + 1) % keys.size] %>
  <div class="position-fixed bottom-0 start-50 translate-middle-x mb-3 px-3 py-2 rounded-pill bg-dark text-white shadow d-flex align-items-center gap-3" style="z-index: 2000" data-controller="prototype-switcher" data-prototype-switcher-prev-value="<%= url_for(params.permit!.merge(variant: prev_key)) %>" data-prototype-switcher-next-value="<%= url_for(params.permit!.merge(variant: next_key)) %>">
    <%= link_to '←', url_for(params.permit!.merge(variant: prev_key)), class: 'text-white text-decoration-none fs-5', aria: { label: 'Previous variant' } %>
    <span><%= prototype_variant %> (<%= NotificationsPrototypeHelper::PROTOTYPE_VARIANTS[prototype_variant] %>)</span>
    <%= link_to '→', url_for(params.permit!.merge(variant: next_key)), class: 'text-white text-decoration-none fs-5', aria: { label: 'Next variant' } %>
    <button type="button" class="btn btn-sm btn-light" data-action="prototype-switcher#toast">Show sample toast</button>
    <%= link_to params[:empty] ? 'Show sample data' : 'Show empty', url_for(params.permit!.merge(empty: params[:empty] ? nil : 1)), class: 'btn btn-sm btn-outline-light' %>
    <template data-prototype-switcher-target="toast">
      <% toast_text = case prototype_variant
                      when 'A' then safe_join([link_to('Map of the Bay Area, 1906 (bc123df4567)', '#', class: 'text-white text-decoration-underline'), ': gisAssemblyWF:extract-iso19139-metadata'])
                      when 'B' then safe_join([link_to('Map of the Bay Area, 1906', '#', class: 'text-white'), tag.br, 'gisAssemblyWF:extract-iso19139-metadata'])
                      else safe_join(['Map of the Bay Area, 1906. ', link_to('View item', '#', class: 'text-white'), ' · ', link_to('All notifications', notifications_prototype_path(variant: 'C'), class: 'text-white')])
                      end %>
      <%= render SdrViewComponents::Elements::ToastComponent.new(title: 'Deposit failed', text: toast_text, variant: :red) %>
    </template>
  </div>
<% end %>
