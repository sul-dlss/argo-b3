<%# PROTOTYPE variant C: bell icon only in the header; notifications grouped by what they are about; settings as a tab. %>
<%= render Layout::ContainerComponent.new(heading: 'Notifications') do %>
  <%= render SdrViewComponents::Elements::Tabs::TabListComponent.new(variant: :underline, content_classes: 'mt-4') do |tabs| %>
    <% tabs.with_tab(id: 'recent-tab', pane_id: 'recent-pane', label: 'Recent', active: true) %>
    <% tabs.with_tab(id: 'email-tab', pane_id: 'email-pane', label: 'Email settings') %>
    <%= tabs.with_pane(id: 'recent-pane', tab_id: 'recent-tab', active: true) do %>
      <% if notifications.empty? %>
        <p>No notifications.</p>
      <% end %>
      <% notifications.group_by(&:subject_label).each do |subject_label, group| %>
        <%= render SdrViewComponents::Elements::CardComponent.new(classes: 'mb-3') do |card| %>
          <% card.with_header do %>
            <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h2, variant: :h5, classes: 'mb-0', text: link_to(subject_label, '#')) %>
          <% end %>
          <% card.with_body do %>
            <% group.each do |notification| %>
              <div class="d-flex gap-2 mb-2">
                <i class="bi <%= prototype_outcome_icon(notification.outcome) %>" aria-hidden="true"></i>
                <div class="flex-grow-1">
                  <span class="fw-bold"><%= notification.title %></span>
                  <span class="text-body-secondary">· <%= time_ago_in_words(notification.created_at) %> ago</span>
                  <% if notification.text %><div><%= notification.text %></div><% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <%= tabs.with_pane(id: 'email-pane', tab_id: 'email-tab') do %>
      <%= render 'settings_form', email_kinds:, cancel_path: notifications_prototype_path(variant: 'C') %>
    <% end %>
  <% end %>
<% end %>
