<%# PROTOTYPE (throwaway, never merge): stub form, Save does nothing. %>
<%= form_with url: '#', method: :get, class: 'b3-form', data: { turbo: false } do |form| %>
  <%= render SdrViewComponents::Forms::FieldsetComponent.new(label: 'Email me when', help_text: 'Emails about something you can act on are sent 10 minutes later, and not sent if you act on it first.') do %>
    <% email_kinds.each_with_index do |(label, help), index| %>
      <div class="form-check mb-2">
        <%= form.check_box "kind_#{index}", class: 'form-check-input', checked: index != 1 %>
        <%= form.label "kind_#{index}", label, class: 'form-check-label' %>
        <div class="form-text"><%= help %></div>
      </div>
    <% end %>
  <% end %>
  <%= render Elements::FormFooterComponent.new(cancel_path:) do %>
    <%= render SdrViewComponents::Elements::ButtonComponent.new(label: 'Save', variant: :primary, type: :submit) %>
  <% end %>
<% end %>
