<%= page_title(t('edit.multi_item_deposits.edit.page_titles.deposit'), name: @multi_item_deposit_action.name) %>

<%= render Layout::ContainerComponent.new(heading: t('edit.multi_item_deposits.edit.title')) do %>

  <p><%= @multi_item_deposit_action.name %></p>

  <%= render MultiItemDeposit::ProgressStepperComponent.new(multi_item_deposit_action: @multi_item_deposit_action) %>

  <%= form_with model: @deposit_form, url: multi_item_deposit_action_path(@multi_item_deposit_action), method: :patch, class: 'b3-form' do |form| %>
    <% if @multi_item_deposit_action.all_initial_versions? %>
      <%# When all are initial versions, the version description is fixed, so rendering a disabled text input. %>
      <%= render Edit::VersionDescriptionComponent.new(
            form:,
            disabled: true,
            label_classes: 'fw-bold',
            help_text: t('edit.multi_item_deposits.fields.version_description.initial_version_help_text')
          ) %>
    <% else %>
      <%= render Edit::VersionDescriptionComponent.new(
            form:,
            label_classes: 'fw-bold',
            help_text: t('edit.multi_item_deposits.fields.version_description.help_text')
          ) %>
    <% end %>

    <% if @multi_item_deposit_action.initiating_deposit_completed_at.present? %>
      <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h2, text: t('edit.multi_item_deposits.edit.deposit_results.heading'), classes: 'mb-3') %>

      <%= render MultiItemDeposit::DepositErrorDetailsTableComponent.new(multi_item_deposit_action: @multi_item_deposit_action) %>
    <% end %>

    <%= render Elements::FormFooterComponent.new(cancel_path: root_path) do %>
      <%= render SdrViewComponents::Forms::SubmitComponent.new(value: MultiItemDepositActionsController::PREVIOUS_VALUE, variant: :'outline-primary') do %>
        <%= left_arrow_icon(aria: { hidden: true }) %> <%= t('edit.multi_item_deposits.edit.buttons.previous') %>
      <% end %>
      <%= render SdrViewComponents::Forms::SubmitComponent.new(label: t('edit.multi_item_deposits.edit.buttons.deposit')) %>
      <%= render MultiItemDeposit::DiscardButtonComponent.new(multi_item_deposit_action: @multi_item_deposit_action) %>
    <% end %>
  <% end %>
<% end %>
