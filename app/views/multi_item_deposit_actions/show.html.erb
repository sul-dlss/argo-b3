<%= page_title(t('edit.multi_item_deposits.show.title'), name: @multi_item_deposit_action.name) %>

<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
<% end %>

<%= render Layout::ContainerComponent.new(heading: t('edit.multi_item_deposits.show.title'), subtitle: @multi_item_deposit_action.name, data: {
                                            controller: 'scheduled-refresh',
                                            scheduled_refresh_interval_value: Settings.reload_intervals.multi_item_deposit_show
                                          }) do |container| %>
  <% container.with_breadcrumb do %>
    <%= render Elements::BreadcrumbComponent.new(label: 'Dashboard', link: root_path) %>
  <% end %>

  <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h2, text: t('multi_item_deposit.deposit_status.label'), classes: 'mb-2') %>

  <p><%= t('edit.multi_item_deposits.show.description') %></p>

  <%= render MultiItemDeposit::DepositStatusCountsComponent.new(object_status_presenters: @object_status_presenters) %>

  <%= render MultiItemDeposit::DepositStatusTableComponent.new(object_status_presenters: @object_status_presenters) %>
<% end %>
