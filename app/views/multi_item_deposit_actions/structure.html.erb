<%= page_title(t('edit.multi_item_deposits.edit.page_titles.structure'), name: @multi_item_deposit_action.name) %>

<%= render Layout::ContainerComponent.new(heading: t('edit.multi_item_deposits.edit.title')) do %>

  <p><%= @multi_item_deposit_action.name %></p>

  <%= render MultiItemDeposit::ProgressStepperComponent.new(multi_item_deposit_action: @multi_item_deposit_action) %>

  <%= form_with model: @structure_form, url: multi_item_deposit_action_path(@multi_item_deposit_action), method: :patch, class: 'b3-form' do |form| %>
    <%# A deposit may have items of several content types, so each text extraction applies to its own types. %>
    <% if @multi_item_deposit_action.ocr_applicable? %>
      <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h2, variant: :h5, text: t('edit.multi_item_deposits.edit.text_extraction.ocr_heading')) %>
      <div data-controller="ocr-options">
        <%= render Edit::OcrComponent.new(form:) %>
      </div>

      <%= render SdrViewComponents::Elements::HorizontalRuleComponent.new %>
    <% end %>

    <% if @multi_item_deposit_action.speech_to_text_applicable? %>
      <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h2, variant: :h5, text: t('edit.multi_item_deposits.edit.text_extraction.speech_to_text_heading')) %>
      <%= render Edit::SpeechToTextComponent.new(form:) %>

      <%= render SdrViewComponents::Elements::HorizontalRuleComponent.new %>
    <% end %>

    <%= render SdrViewComponents::Forms::RadioButtonGroupComponent.new(
          form:,
          field_name: :structural_metadata_csv_choice,
          label: t('edit.multi_item_deposits.fields.structural_metadata_csv_choice.label'),
          classes: 'my-fieldset',
          mark_required: true,
          data: { controller: 'radio' }
        ) do |group| %>
      <% group.with_radio_button(
           label_text: t('edit.multi_item_deposits.fields.structural_metadata_csv_choice.upload.label'),
           input_value: MultiItemDeposit::StructureForm::UPLOAD_CHOICE,
           input_data: { radio_target: 'radio', action: 'radio#toggle' },
           container_classes: 'my-fieldset'
         ) do %>
        <% if @structure_form.unsaved_structural_metadata_csv? %>
          <%= form.hidden_field :structural_metadata_csv, value: @structure_form.retainable_structural_metadata_csv %>
        <% end %>
        <% if @structure_form.retainable_structural_metadata_csv.present? %>
          <p class="mb-2"><%= t('edit.multi_item_deposits.fields.structural_metadata_csv_file.retained') %></p>
        <% end %>
        <div class="my-2">
          <%= link_to structural_metadata_csv_template_multi_item_deposit_action_path(@multi_item_deposit_action), download: true do %>
            <%= download_icon(aria: { hidden: true }, classes: 'me-1') %> <%= t('edit.multi_item_deposits.fields.structural_metadata_csv_file.template') %>
          <% end %>
        </div>
        <%= render SdrViewComponents::Forms::FileComponent.new(form:,
                                                               field_name: :structural_metadata_csv_file,
                                                               container_classes: 'my-field',
                                                               label_text: t('edit.multi_item_deposits.fields.structural_metadata_csv_file.label')) %>
      <% end %>

      <% if @multi_item_deposit_action.mount_structural_metadata_csv_path %>
        <% group.with_radio_button(
             label_text: t('edit.multi_item_deposits.fields.structural_metadata_csv_choice.mount.label'),
             input_value: MultiItemDeposit::StructureForm::MOUNT_CHOICE,
             input_data: { radio_target: 'radio', action: 'radio#toggle' },
             container_classes: 'my-fieldset'
           ) %>
      <% end %>

      <% unless @multi_item_deposit_action.structural_metadata_csv_required? %>
        <% group.with_radio_button(
             label_text: t('edit.multi_item_deposits.fields.structural_metadata_csv_choice.none.label'),
             input_value: MultiItemDeposit::StructureForm::NONE_CHOICE,
             input_data: { radio_target: 'radio', action: 'radio#toggle' },
             container_classes: 'my-fieldset'
           ) do %>
          <%= render SdrViewComponents::Forms::RadioButtonGroupComponent.new(
                form:,
                field_name: :publish_preserve_all,
                label: t('edit.multi_item_deposits.fields.publish_preserve_all.label'),
                classes: 'my-fieldset'
              ) do |publish_preserve_group| %>
            <% publish_preserve_group.with_radio_button(
                 label_text: t('edit.multi_item_deposits.fields.publish_preserve_all.default.label'),
                 input_value: 'false'
               ) %>
            <% publish_preserve_group.with_radio_button(
                 label_text: t('edit.multi_item_deposits.fields.publish_preserve_all.all.label'),
                 input_value: 'true'
               ) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% if @multi_item_deposit_action.structuring_completed_at.present? %>
      <div class="d-flex flex-wrap align-items-baseline column-gap-4 mb-3">
        <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h2, text: t('edit.multi_item_deposits.edit.structure_results.heading'), classes: 'mb-0') %>
        <%= link_to structure_report_multi_item_deposit_action_path(@multi_item_deposit_action), download: true do %>
          <%= download_icon(aria: { hidden: true }, classes: 'me-1') %> <%= t('edit.multi_item_deposits.edit.structure_results.download_report') %>
        <% end %>
      </div>

      <%= render MultiItemDeposit::SummaryTableComponent.new(multi_item_deposit_action: @multi_item_deposit_action) %>
    <% end %>

    <%= render Elements::FormFooterComponent.new(cancel_path: root_path) do %>
      <% next_enabled = @multi_item_deposit_action.structuring_succeeded? %>
      <%= render SdrViewComponents::Forms::SubmitComponent.new(label: t('edit.multi_item_deposits.edit.buttons.build_structure'), variant: next_enabled ? :'outline-primary' : :primary) %>
      <%= render SdrViewComponents::Forms::SubmitComponent.new(value: MultiItemDepositActionsController::PREVIOUS_VALUE, variant: :'outline-primary') do %>
        <%= left_arrow_icon(aria: { hidden: true }) %> <%= t('edit.multi_item_deposits.edit.buttons.previous') %>
      <% end %>
      <%= render SdrViewComponents::Forms::SubmitComponent.new(value: MultiItemDepositActionsController::NEXT_VALUE, disabled: !next_enabled) do %>
        <%= t('edit.multi_item_deposits.edit.buttons.next') %> <%= right_arrow_icon(aria: { hidden: true }) %>
      <% end %>
    <% end %>
  <% end %>

<% end %>
