<%= content_for :title, t('edit.multi_item_deposits.edit.title') %>

<div class="container py-2">
  <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h1, text: t('edit.multi_item_deposits.edit.title'), classes: 'mb-3') %>

  <%= form_with model: @discovery_form, url: multi_item_deposit_action_path(@multi_item_deposit_action), method: :patch, class: 'b3-form' do |form| %>
    <%= render SdrViewComponents::Forms::TextAreaComponent.new(form:,
                                                               field_name: :description,
                                                               container_classes: 'my-fieldset',
                                                               label_text: t('edit.multi_item_deposits.fields.description.label'),
                                                               label_classes: 'fw-bold',
                                                               input_rows: 3) %>

    <%= render SdrViewComponents::Forms::FieldsetComponent.new(
          label: t('edit.multi_item_deposits.fields.discovery.label'),
          label_classes: 'h2',
          help_text: t('edit.multi_item_deposits.fields.discovery.help_text'),
          mark_required: true
        ) do %>
      <%= render SdrViewComponents::Forms::FieldsetComponent.new(
            label: t('edit.multi_item_deposits.fields.manifest_source.label'),
            mark_required: true,
            data: { controller: 'radio' }
          ) do %>
        <%= render SdrViewComponents::Forms::RadioButtonComponent.new(
              form:,
              field_name: :manifest_source,
              label_text: t('edit.multi_item_deposits.fields.manifest_source.upload.label'),
              input_value: MultiItemDepositAction.manifest_sources[:upload],
              input_data: { radio_target: 'radio', action: 'radio#toggle' },
              container_classes: 'my-fieldset'
            ) do |component| %>
          <% component.with_additional_container_content do %>
            <% if @discovery_form.unsaved_manifest_csv?(@multi_item_deposit_action) %>
              <%= form.hidden_field :manifest_csv, value: @discovery_form.retainable_manifest_csv %>
            <% end %>
            <% if @discovery_form.retainable_manifest_csv.present? %>
              <p class="mb-1"><%= t('edit.multi_item_deposits.fields.manifest_file.retained') %></p>
            <% end %>
            <%= render SdrViewComponents::Forms::FileComponent.new(form:,
                                                                   field_name: :manifest_file,
                                                                   container_classes: 'my-field',
                                                                   label_text: t('edit.multi_item_deposits.fields.manifest_file.label'),
                                                                   label_hidden: true) %>
          <% end %>
        <% end %>

        <%= render SdrViewComponents::Forms::RadioButtonComponent.new(
              form:,
              field_name: :manifest_source,
              label_text: t('edit.multi_item_deposits.fields.manifest_source.mount.label'),
              input_value: MultiItemDepositAction.manifest_sources[:mount],
              input_data: { radio_target: 'radio', action: 'radio#toggle' },
              container_classes: 'my-fieldset'
            ) do |component| %>
          <% component.with_additional_container_content do %>
            <%= render SdrViewComponents::Forms::InvalidFeedbackComponent.new(form:, field_name: :manifest_source) %>
          <% end %>
        <% end %>
      <% end %>

      <%= render SdrViewComponents::Forms::FieldsetComponent.new(
            label: t('edit.multi_item_deposits.fields.file_location.label'),
            mark_required: true,
            data: { controller: 'radio' }
          ) do %>
        <%# Globus is not yet supported. %>
        <%= render SdrViewComponents::Forms::RadioButtonComponent.new(
              form:,
              field_name: :file_location,
              label_text: t('edit.multi_item_deposits.fields.file_location.globus.label'),
              input_value: MultiItemDepositAction.file_locations[:globus],
              input_disabled: true,
              input_data: { radio_target: 'radio', action: 'radio#toggle' },
              container_classes: 'my-fieldset'
            ) %>

        <%= render SdrViewComponents::Forms::RadioButtonComponent.new(
              form:,
              field_name: :file_location,
              label_text: t('edit.multi_item_deposits.fields.file_location.mount.label'),
              input_value: MultiItemDepositAction.file_locations[:mount],
              input_data: { radio_target: 'radio', action: 'radio#toggle' },
              container_classes: 'my-fieldset'
            ) do |component| %>
          <% component.with_additional_container_content do %>
            <%= render SdrViewComponents::Forms::TextFieldComponent.new(form:,
                                                                        field_name: :mount_path,
                                                                        container_classes: 'my-field',
                                                                        label_text: t('edit.multi_item_deposits.fields.mount_path.label')) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
    <% if @multi_item_deposit_action.discovery_completed_at.present? %>
      <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h2, text: t('edit.multi_item_deposits.edit.discovery_results.heading'), classes: 'mb-3') %>

      <% unless @multi_item_deposit_action.discovery_succeeded? %>
        <%= render SdrViewComponents::Elements::AlertComponent.new(variant: :danger, title: t('edit.multi_item_deposits.edit.discovery_errors_alert.title')) do %>
          <%= t('edit.multi_item_deposits.edit.discovery_errors_alert.body', discover_label: t('edit.multi_item_deposits.edit.buttons.discover')) %>
        <% end %>
      <% else %>
        <%= render SdrViewComponents::Elements::AlertComponent.new(variant: :success, title: t('edit.multi_item_deposits.edit.no_discovery_errors_alert.title')) do %>
          <%= t('edit.multi_item_deposits.edit.no_discovery_errors_alert.body', next_label: t('edit.multi_item_deposits.edit.buttons.next')) %>
        <% end %>
      <% end %>

      <%= render MultiItemDeposit::ErrorDetailsTableComponent.new(multi_item_deposit_action: @multi_item_deposit_action) %>
    <% end %>
    <div class="mt-3">
      <%= render SdrViewComponents::Elements::ButtonLinkComponent.new(label: t('edit.multi_item_deposits.edit.buttons.cancel'), link: root_path, variant: :link, classes: 'me-3') %>
      <%= render SdrViewComponents::Forms::SubmitComponent.new(label: t('edit.multi_item_deposits.edit.buttons.discover')) %>
      <%= render SdrViewComponents::Forms::SubmitComponent.new(value: MultiItemDepositActionsController::NEXT_VALUE, classes: 'ms-2', disabled: !@multi_item_deposit_action.discovery_succeeded?) do %>
        <%= t('edit.multi_item_deposits.edit.buttons.next') %> <%= right_arrow_icon %>
      <% end %>
    </div>
  <% end %>
</div>
