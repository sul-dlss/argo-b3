<%= turbo_frame_tag @content, 'globus' do %>
  <%= render Elements::FlashToastComponent.new %>
  <% if @files_discovered %>
    <%= tag.div data: { controller: 'frame-reloader', frame_reloader_reloadable_frame_outlet: '.content-files-frame' } %>
  <% end %>
  <% if @error %>
    <p class="text-danger"><%= @error %></p>
  <% end %>
  <% if @directory_writable %>
    <p><%= t('edit.contents.globus.instructions') %></p>
    <div class="d-flex gap-2">
      <%= render SdrViewComponents::Elements::ButtonLinkComponent.new(label: t('edit.contents.globus.buttons.open'),
                                                                      link: @globus_directory.url,
                                                                      target: '_blank', rel: 'noopener') %>

      <%= form_with url: discover_content_globus_path(@content_token), method: :post do %>
        <%= render SdrViewComponents::Forms::SubmitComponent.new(label: t('edit.contents.edit.buttons.discover_files')) %>
      <% end %>
    </div>
  <% else %>
    <%# Creating the link can take several seconds, so a spinner is shown while it is created. %>
    <div class="spinner-on-submit">
      <%= form_with url: content_globus_path(@content_token), method: :post do %>
        <%= render SdrViewComponents::Forms::SubmitComponent.new(label: t('edit.contents.globus.buttons.create')) %>
      <% end %>
      <%= render Elements::RosetteSpinnerComponent.new(size: :small, message: t('edit.contents.globus.spinner'), classes: 'submit-spinner mt-2') %>
    </div>
  <% end %>
<% end %>
