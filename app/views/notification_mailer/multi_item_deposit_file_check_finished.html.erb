<% url = multi_item_deposit_action_url(@multi_item_deposit_action) %>
<% if @with_errors %>
  <p><%= t('.body_with_errors_html', deposit: @deposit_label, url: link_to(url, url)) %></p>
  <p><%= t('.errors_found') %></p>
  <ul>
    <% @errors.each do |error| %>
      <li><%= error %></li>
    <% end %>
  </ul>
  <% if @unlisted_error_count.positive? %>
    <p><%= t('.more_errors', count: @unlisted_error_count) %></p>
  <% end %>
<% else %>
  <p><%= t('.body_html', deposit: @deposit_label, url: link_to(url, url)) %></p>
<% end %>
