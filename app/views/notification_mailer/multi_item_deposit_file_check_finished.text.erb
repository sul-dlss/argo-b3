<% url = multi_item_deposit_action_url(@multi_item_deposit_action) -%>
<% if @with_errors -%>
<%= t('.body_with_errors', deposit: @deposit_label, url:) %>

<%= t('.errors_found') %>
<% @errors.each do |error| -%>
- <%= error %>
<% end -%>
<% if @unlisted_error_count.positive? -%>
<%= t('.more_errors', count: @unlisted_error_count) %>
<% end -%>
<% else -%>
<%= t('.body', deposit: @deposit_label, url:) %>
<% end -%>
