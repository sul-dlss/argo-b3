<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
<% end %>

<%= render Layout::ContainerComponent.new(heading: @workgroup) do |container| %>
  <% container.with_breadcrumb do %>
    <%= render Elements::BreadcrumbComponent.new(label: 'Workgroup permissions', link: admin_workgroup_permissions_path) %>
  <% end %>
  <%= render SdrViewComponents::Elements::HeadingComponent.new(level: :h2, text: 'Permissions', classes: 'mb-4') %>

  <%= form_with model: @workgroup_permission_form, url: admin_workgroup_permission_path(@workgroup), method: :patch do |form| %>
    <%# The floated legend is a flex item, so it sits inline before the radios. %>
    <%= render SdrViewComponents::Forms::FieldsetComponent.new(label: 'Read unrestricted', label_classes: 'mb-0',
                                                               classes: 'd-flex align-items-center gap-4 pt-2', legend_classes: 'w-auto mb-0 fs-6') do %>
      <div class="d-flex align-items-center gap-4">
        <%= render SdrViewComponents::Forms::RadioButtonComponent.new(form:, field_name: :read_unrestricted, label_text: 'Yes', input_value: 'true',
                                                                      container_classes: 'd-flex align-items-center gap-2 ps-0', input_classes: 'order-first ms-0') %>
        <%= render SdrViewComponents::Forms::RadioButtonComponent.new(form:, field_name: :read_unrestricted, label_text: 'No', input_value: 'false',
                                                                      container_classes: 'd-flex align-items-center gap-2 ps-0', input_classes: 'order-first ms-0') %>
      </div>
    <% end %>

    <div class="mt-3">
      <%= render SdrViewComponents::Elements::ButtonLinkComponent.new(label: 'Cancel', link: admin_workgroup_permissions_path, variant: :link, classes: 'me-3') %>
      <%= render SdrViewComponents::Forms::SubmitComponent.new(label: 'Save') %>
    </div>
  <% end %>

  <hr class="my-4">

  <%= render SdrViewComponents::Tables::RawTableComponent.new(label: 'Additional permissions', show_label: false, variant: :h3,
                                                              id: 'additional-permissions-table', empty_message: 'No additional permissions.') do |table| %>
    <%= table.with_header(label: 'Title') %>
    <%= table.with_header(label: 'Druid') %>
    <%= table.with_header(label: 'Object type') %>
    <%= table.with_header(label: 'Permission') %>
    <%= table.with_header(label: tag.span('Actions', class: 'visually-hidden')) %>
    <% @additional_permissions.each do |permission| %>
      <% table.with_row do %>
        <%= render Admin::WorkgroupPermissionRowComponent.new(permission:, object_doc: @object_docs_by_druid[permission.target_druid]) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
