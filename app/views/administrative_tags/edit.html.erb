<%= render Layout::ContainerComponent.new(heading: t('edit.administrative_tags.edit.title'), subtitle: @title) do %>

  <%= form_with model: @administrative_tags_form, url: object_tags_path(@druid), method: :patch, class: 'b3-form' do |form| %>
    <%= render Edit::TagsComponent.new(form:) %>

    <%= render Elements::FormFooterComponent.new(cancel_path: object_path(@druid)) do %>
      <%= render SdrViewComponents::Forms::SubmitComponent.new(label: t('edit.administrative_tags.edit.buttons.save')) %>
    <% end %>
  <% end %>
<% end %>
