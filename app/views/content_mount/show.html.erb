<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
<% end %>

<%= turbo_frame_tag @content, 'mount' do %>
  <% if @discovery_started %>
    <%# Reloading the files sections disables deleting files during discovery. %>
    <%= tag.div data: { controller: 'frame-reloader', frame_reloader_reloadable_frame_outlet: '.content-files-frame' } %>
  <% end %>
  <%# Reloading from the url (rather than the frame's src) drops discovery_started, so the files sections are only reloaded once. %>
  <%= tag.div data: { controller: 'frame-reload',
                      frame_reload_interval_value: Settings.reload_intervals.mount_discovery,
                      frame_reload_url_value: content_mount_path(@content_token) } do %>
    <%= render Elements::RosetteSpinnerComponent.new(size: :small, message: 'Discovering files...') %>
  <% end %>
<% end %>
