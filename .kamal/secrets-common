# Secrets shared across all destinations. All secrets should be pulled from
# either password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE!
# This file needs to be safe for git.

# No registry credentials needed: config/deploy.yml uses Kamal's local registry mode
# (registry.server: localhost:5555), which requires no login.

# Kamal secrets files support variable interpolation and command substitution,
# but not shell assignment expansion (e.g. ${VAR:=fallback}). Keep this file to
# ENV dereferencing only. In CI, Jenkins injects these values. Locally, use
# bin/kamal-env-from-vault to export them before running Kamal.
HONEYBADGER_API_KEY=${HONEYBADGER_API_KEY}
SECRET_KEY_BASE=${SECRET_KEY_BASE}
SETTINGS__DOR_SERVICES__TOKEN=${SETTINGS__DOR_SERVICES__TOKEN}
SETTINGS__PRESERVATION_CATALOG__TOKEN=${SETTINGS__PRESERVATION_CATALOG__TOKEN}
DATABASE_PASSWORD=${DATABASE_PASSWORD}
SETTINGS__FOLIO__OKAPI__PASSWORD=${SETTINGS__FOLIO__OKAPI__PASSWORD}
SETTINGS__RABBITMQ__USERNAME=${SETTINGS__RABBITMQ__USERNAME}
SETTINGS__RABBITMQ__PASSWORD=${SETTINGS__RABBITMQ__PASSWORD}