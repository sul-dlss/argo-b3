# Secrets shared across all destinations. All secrets should be pulled from
# either password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE!
# This file needs to be safe for git.

# No registry credentials needed: config/deploy.yml uses Kamal's local registry mode
# (registry.server: localhost:5555), which requires no login.

# Secrets are pulled from Vault. Prompt for `vault login -method oidc` if the
# current token is missing or expired, before any of the `vault kv get` calls
# below run.
_VAULT_LOGIN_CHECK=$(vault token lookup >/dev/null 2>&1 || vault login -method oidc >&2)

# Kamal sets KAMAL_DESTINATION before secrets are parsed, so the environment-specific
# path segment below can be interpolated rather than duplicated per .kamal/secrets.<destination>
# file.
HONEYBADGER_API_KEY=$(vault kv get -field=content puppet/application/argo-b3/honeybadger-api-key)
SECRET_KEY_BASE=$(vault kv get -field=content puppet/application/argo-b3/$KAMAL_DESTINATION/secret-key-base)
SETTINGS__DOR_SERVICES__TOKEN=$(vault kv get -field=content puppet/application/argo-b3/$KAMAL_DESTINATION/dor-services-token)
SETTINGS__PRESERVATION_CATALOG__TOKEN=$(vault kv get -field=content puppet/application/argo-b3/$KAMAL_DESTINATION/preservation-catalog-token)
DATABASE_PASSWORD=$(vault kv get -field=content puppet/application/argo-b3/$KAMAL_DESTINATION/lyberadmin-db-pwd)
