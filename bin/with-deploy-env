#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs a command with environment variables taken from the Kamal deploy config
# (config/deploy.yml + config/deploy.<destination>.yml), fetching secret values from Vault.
# Secrets are passed only through the command's environment.
#
# Modes:
#   --secrets   every env.secret var (for Kamal deploys, which supply env.clear themselves).
#   --settings  the SETTINGS__* env.clear and env.secret vars (for local dev), except
#               those in LOCAL_SETTING_EXCLUSIONS.
#
# Vars already set in the environment are left as-is.
#
# Usage: bin/with-deploy-env DESTINATION (--secrets|--settings) -- COMMAND [ARGS...]

require 'bundler/setup'
require 'kamal'
require 'open3'
require 'pathname'

USAGE = 'Usage: bin/with-deploy-env DESTINATION (--secrets|--settings) -- COMMAND [ARGS...]'

# Not applied in --settings mode: event publishing stays off unless exported, and the
# server's Globus mount isn't available locally (config/settings/development.yml is used instead).
LOCAL_SETTING_EXCLUSIONS = %w[SETTINGS__RABBITMQ__ENABLED SETTINGS__GLOBUS__DIRECTORY].freeze

def vault_secret_path(key, destination)
  case key
  when 'HONEYBADGER_API_KEY' then 'puppet/application/argo-b3/honeybadger-api-key'
  when 'SECRET_KEY_BASE' then "puppet/application/argo-b3/#{destination}/secret-key-base"
  when 'SETTINGS__DOR_SERVICES__TOKEN' then "puppet/application/argo-b3/#{destination}/dor-services-token"
  when 'SETTINGS__PRESERVATION_CATALOG__TOKEN' then "puppet/application/argo-b3/#{destination}/preservation-catalog-token"
  when 'DATABASE_PASSWORD' then "puppet/application/argo-b3/#{destination}/lyberadmin-db-pwd"
  when 'SETTINGS__FOLIO__OKAPI__PASSWORD' then 'puppet/application/folio/app_sdr_password'
  when 'SETTINGS__RABBITMQ__USERNAME' then "puppet/application/argo-b3/#{destination}/rabbitmq-username"
  when 'SETTINGS__RABBITMQ__PASSWORD' then "puppet/application/argo-b3/#{destination}/rabbitmq-password"
  when 'SETTINGS__TECH_MD_SERVICE__TOKEN' then "puppet/application/argo-b3/#{destination}/tech-md-service-token"
  when 'SETTINGS__GLOBUS__CLIENT_ID' then "puppet/application/argo-b3/#{destination}/globus-client-id"
  when 'SETTINGS__GLOBUS__CLIENT_SECRET' then "puppet/application/argo-b3/#{destination}/globus-client-secret"
  when 'SETTINGS__GLOBUS__ENDPOINT_ID' then "puppet/application/argo-b3/#{destination}/globus-endpoint-id"
  else
    raise "No Vault path for secret: #{key}"
  end
end

def vault_available?
  system('vault', '-version', out: File::NULL, err: File::NULL)
end

def ensure_vault_login!
  return if system('vault', 'token', 'lookup', out: File::NULL, err: File::NULL)

  warn 'Vault token missing or expired; launching `vault login -method oidc`...'
  # Keep login output (which includes the token) off stdout.
  system('vault', 'login', '-method', 'oidc', out: $stderr, exception: true)
end

def fetch_secret_from_vault(path)
  stdout, stderr, status = Open3.capture3('vault', 'kv', 'get', '-field=content', path)
  return stdout.strip if status.success?

  raise "Unable to read Vault secret at #{path}: #{stderr.strip}"
end

def local_setting?(key)
  key.start_with?('SETTINGS__') && !LOCAL_SETTING_EXCLUSIONS.include?(key)
end

def populate_missing_secrets_from_vault!(keys, destination)
  missing_keys = keys.select { |key| ENV[key].to_s.empty? }
  return if missing_keys.empty?

  raise "Missing secrets in environment (#{missing_keys.join(', ')}) and `vault` CLI is unavailable" unless vault_available?

  ensure_vault_login!

  missing_keys.each do |key|
    ENV[key] = fetch_secret_from_vault(vault_secret_path(key, destination))
  end
end

destination, mode, separator, *command = ARGV

unless %w[qa stage prod].include?(destination) && %w[--secrets --settings].include?(mode) && separator == '--' && command.any?
  warn USAGE
  exit 1
end

begin
  env = Kamal::Configuration.create_from(config_file: Pathname.new('config/deploy.yml'), destination: destination).env

  if mode == '--settings'
    env.clear.each { |key, value| ENV[key] = value.to_s if local_setting?(key) && ENV[key].to_s.empty? }
    populate_missing_secrets_from_vault!(env.secret_keys.select { |key| local_setting?(key) }, destination)
  else
    populate_missing_secrets_from_vault!(env.secret_keys, destination)
  end
rescue StandardError => e
  warn e.message
  exit 1
end

exec(*command)
