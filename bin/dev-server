#!/usr/bin/env sh
#
# Opens an SSH tunnel to server Solr and starts bin/setup pointed at it, along
# with DSA, PresCat, techmd, Folio, stacks, purl-fetcher, etc. for the same environment.
#
# Usage: bin/dev-server [qa|stage|prod] [console]
# Defaults to qa. prod additionally requires ALLOW_PROD=true.
#
# Service settings come from config/deploy.<env>.yml and their secrets (tokens, Folio
# password) from Vault, via bin/with-deploy-env. Any SETTINGS__* var already exported
# takes precedence. RabbitMQ is configured but disabled; export SETTINGS__RABBITMQ__ENABLED=true
# to publish events to the environment's RabbitMQ.

set -e

SERVER_ENV="${1:-qa}" # default to qa
RUN_CONSOLE="${2:-}"

if [ "$SERVER_ENV" = "console" ]; then
  SERVER_ENV="qa"
  RUN_CONSOLE="console"
fi

case "$SERVER_ENV" in
  qa|stage|prod) ;;
  *)
    echo "Usage: bin/dev-server [qa|stage|prod] [console]" >&2
    exit 1
    ;;
esac

if [ "$SERVER_ENV" = "prod" ] && [ "$ALLOW_PROD" != "true" ]; then
  echo "Refusing to run against prod. Rerun with ALLOW_PROD=true bin/dev-server prod if you really mean it." >&2
  exit 1
fi

# db and redis are the only local containers this script needs; Solr, DSA,
# PresCat, and techmd are tunneled to the remote server environment instead.
if ! docker info >/dev/null 2>&1; then
  echo "Docker does not appear to be running. Please start Docker and try again." >&2
  exit 1
fi
docker compose up -d db redis

# check for dlss-capistrano's controlmaster:setup/:start tasks:
# https://github.com/sul-dlss/dlss-capistrano/blob/main/lib/dlss/capistrano/tasks/control_master.rake
ensure_controlmaster() {
  controlmaster_host="${CONTROLMASTER_HOST:-dlss-jump}"
  controlmaster_socket="${CONTROLMASTER_SOCKET:-~/.ssh/%r@%h:%p}"

  ssh -O check -S "$controlmaster_socket" "$controlmaster_host" && return 0

  ssh -f -N -S "$controlmaster_socket" "$controlmaster_host"
}

ensure_controlmaster

ssh -N -T -L 8990:sul-solr-prod-a.stanford.edu:80 lyberadmin@argo-b3-prod-a.stanford.edu &
TUNNEL_PID=$!

trap 'kill "$TUNNEL_PID" 2>/dev/null' EXIT

# give the tunnel a moment to establish before hitting it
sleep 2

export SETTINGS__SOLR__URL="${SETTINGS__SOLR__URL:-http://localhost:8990/solr/argo_${SERVER_ENV}}"

if [ "$RUN_CONSOLE" = "console" ]; then
  bin/with-deploy-env "$SERVER_ENV" --settings -- sh -c 'bin/setup --skip-server && bin/rails console'
else
  bin/with-deploy-env "$SERVER_ENV" --settings -- bin/setup
fi
