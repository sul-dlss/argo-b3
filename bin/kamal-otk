#!/usr/bin/env ruby
# frozen_string_literal: true

# Deploys via Kamal using a one-time SSH key, analogous to capistrano-one_time_key
# (https://github.com/cbeer/capistrano-one_time_key). Generates a fresh, passphrase-less
# keypair, adds the public key to each target host's ~/.ssh/authorized_keys (relying on
# whatever trusted channel -- e.g. Kerberos/ksu -- already lets that connection succeed),
# runs `bin/kamal` using that key, then always removes it from authorized_keys.
#
# The key is both configured via config/deploy.<destination>.yml's `ssh.keys` (read from
# KAMAL_SSH_KEY_PATH) and loaded into a scratch ssh-agent: Kamal's remote-builder port
# forwarding (lib/kamal/cli/build.rb#remote_builder_ssh_options) builds its own SSH options
# from the `builder.remote` URI and doesn't include configured keys, so it only succeeds
# via agent-based auth.
#
# Usage: bin/kamal-otk DESTINATION [kamal args...]

require 'bundler/setup'
require 'kamal'
require 'open3'
require 'pathname'
require 'securerandom'
require 'tmpdir'
require 'uri'

REQUIRED_DEPLOY_SECRETS = [
  'HONEYBADGER_API_KEY',
  'SECRET_KEY_BASE',
  'SETTINGS__DOR_SERVICES__TOKEN',
  'SETTINGS__PRESERVATION_CATALOG__TOKEN',
  'DATABASE_PASSWORD',
  'SETTINGS__FOLIO__OKAPI__PASSWORD',
  'SETTINGS__RABBITMQ__USERNAME',
  'SETTINGS__RABBITMQ__PASSWORD'
].freeze

def vault_secret_path(key, destination)
  case key
  when 'HONEYBADGER_API_KEY' then 'puppet/application/argo-b3/honeybadger-api-key'
  when 'SECRET_KEY_BASE' then "puppet/application/argo-b3/#{destination}/secret-key-base"
  when 'SETTINGS__DOR_SERVICES__TOKEN' then "puppet/application/argo-b3/#{destination}/dor-services-token"
  when 'SETTINGS__PRESERVATION_CATALOG__TOKEN' then "puppet/application/argo-b3/#{destination}/preservation-catalog-token"
  when 'DATABASE_PASSWORD' then "puppet/application/argo-b3/#{destination}/lyberadmin-db-pwd"
  when 'SETTINGS__FOLIO__OKAPI__PASSWORD' then 'puppet/application/folio/app_sdr_password'
  when 'SETTINGS__RABBITMQ__USERNAME' then "puppet/application/argo-b3/#{destination}/rabbitmq-username"
  when 'SETTINGS__RABBITMQ__PASSWORD' then "puppet/application/argo-b3/#{destination}/rabbitmq-password"
  else
    raise "Unknown secret key: #{key}"
  end
end

def missing_required_deploy_secrets
  REQUIRED_DEPLOY_SECRETS.select { |key| ENV[key].to_s.empty? }
end

def vault_available?
  system('vault', '-version', out: File::NULL, err: File::NULL)
end

def ensure_vault_login!
  return if system('vault', 'token', 'lookup', out: File::NULL, err: File::NULL)

  warn 'Vault token missing or expired; launching `vault login -method oidc`...'
  system('vault', 'login', '-method', 'oidc', exception: true)
end

def fetch_secret_from_vault(path)
  stdout, stderr, status = Open3.capture3('vault', 'kv', 'get', '-field=content', path)
  return stdout.strip if status.success?

  raise "Unable to read Vault secret at #{path}: #{stderr.strip}"
end

def populate_missing_deploy_secrets_from_vault!(destination)
  missing_secrets = missing_required_deploy_secrets
  return if missing_secrets.empty?

  raise "Missing required deploy secrets in environment (#{missing_secrets.join(', ')}) and `vault` CLI is unavailable" unless vault_available?

  ensure_vault_login!

  missing_secrets.each do |key|
    ENV[key] = fetch_secret_from_vault(vault_secret_path(key, destination))
  end

  remaining_missing_secrets = missing_required_deploy_secrets
  return if remaining_missing_secrets.empty?

  raise "Required deploy secrets are still missing after Vault fetch: #{remaining_missing_secrets.join(', ')}"
end

destination = ARGV.shift
if destination.nil?
  warn 'Usage: bin/kamal-otk [destination, e.g., qa] [kamal args...]'
  exit 1
end

unless %w[qa stage prod].include?(destination)
  warn "Usage error: destination must be one of qa, stage, prod (got #{destination.inspect})"
  exit 1
end

populate_missing_deploy_secrets_from_vault!(destination)

config = Kamal::Configuration.create_from(config_file: Pathname.new('config/deploy.yml'), destination: destination)
# The remote builder (config/deploy.yml's `builder.remote`, shared by all destinations) needs the
# key too, since qa/prod deploys build on the stage host.
builder_hosts = config.builder.remote ? [URI(config.builder.remote).host] : []
hosts = (config.roles.flat_map(&:hosts) + builder_hosts).uniq
user = config.ssh.user

def ssh_exec!(user, host, command)
  system('ssh', "#{user}@#{host}", command, exception: true)
end

# Same mechanism as dlss-capistrano's controlmaster:setup/:start tasks:
# https://github.com/sul-dlss/dlss-capistrano/blob/main/lib/dlss/capistrano/tasks/control_master.rake
def ensure_controlmaster!
  return unless ENV.fetch('USE_CAPISTRANO_CONTROLMASTER', false) == 'true'

  controlmaster_host = ENV.fetch('CONTROLMASTER_HOST', 'dlss-jump')
  controlmaster_socket = ENV.fetch('CONTROLMASTER_SOCKET', '~/.ssh/%r@%h:%p')

  return if system('ssh', '-O', 'check', '-S', controlmaster_socket, controlmaster_host)

  system('ssh', '-f', '-N', '-S', controlmaster_socket, controlmaster_host, exception: true)
end

ensure_controlmaster!

Dir.mktmpdir do |dir|
  key_path = File.join(dir, 'deploy_otk')
  comment = "kamal-otk-#{SecureRandom.hex(6)}"

  system('ssh-keygen', '-q', '-t', 'ed25519', '-f', key_path, '-N', '', '-C', comment, exception: true)
  public_key = File.read("#{key_path}.pub").strip

  add_key_command = "mkdir -p ~/.ssh && chmod 700 ~/.ssh && " \
                     "touch ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys && " \
                     "echo '#{public_key}' >> ~/.ssh/authorized_keys"

  hosts.each { |host| ssh_exec!(user, host, add_key_command) }

  agent_pid = nil
  begin
    `ssh-agent -s`.each_line do |line|
      ENV[Regexp.last_match(1)] = Regexp.last_match(2) if line =~ /^(SSH_AUTH_SOCK|SSH_AGENT_PID)=([^;]+);/
    end
    agent_pid = ENV['SSH_AGENT_PID']
    system('ssh-add', key_path, exception: true)

    ENV['KAMAL_SSH_KEY_PATH'] = key_path
    system('bin/kamal', *ARGV, '-d', destination, exception: true)
  ensure
    system('ssh-agent', '-k') if agent_pid

    # Best-effort cleanup: don't let a removal failure mask the deploy's own result.
    remove_key_command = "sed -i.bak -e '/#{comment}$/d' ~/.ssh/authorized_keys && rm -f ~/.ssh/authorized_keys.bak"
    hosts.each do |host|
      system('ssh', "#{user}@#{host}", remove_key_command) ||
        warn("Failed to remove one-time key from #{host}; remove #{comment} from ~/.ssh/authorized_keys manually.")
    end
  end
end
