#!/usr/bin/env sh

# Overmind refuses to start if .overmind.sock exists. If nothing is listening on
# it, it is left over from an unclean exit, so remove it and carry on.
if [ -S .overmind.sock ] && ! nc -z -U .overmind.sock 2>/dev/null; then
  echo "Removing stale .overmind.sock"
  rm -f .overmind.sock
fi

# USER_GROUPS should be semicolon-separated (no spaces).
USER_GROUPS="${USER_GROUPS:=sdr:argo-access;sdr:argo_administrators}" NAME="${NAME:=A. User}" EMAIL="${EMAIL:=a.user@stanford.edu}" bin/overmind start